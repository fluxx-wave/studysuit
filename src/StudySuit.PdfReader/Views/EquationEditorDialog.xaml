<ui:FluentWindow x:Class="StudySuit.PdfReader.Views.EquationEditorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Math Equation Builder"
                 Width="620"
                 Height="480"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Math Equation Builder"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20,10,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Quick Symbols &amp; Templates"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <WrapPanel.Resources>
                    <Style TargetType="ui:Button">
                        <Setter Property="Appearance" Value="Secondary" />
                        <Setter Property="Padding" Value="9,5" />
                        <Setter Property="Margin" Value="0,0,5,5" />
                        <Setter Property="FontSize" Value="12.5" />
                    </Style>
                </WrapPanel.Resources>
                <ui:Button Content="a / b" Tag="\frac{a}{b}" Click="InsertTemplate_Click" />
                <ui:Button Content="x²" Tag="^{2}" Click="InsertTemplate_Click" />
                <ui:Button Content="xₙ" Tag="_{n}" Click="InsertTemplate_Click" />
                <ui:Button Content="√x" Tag="\sqrt{x}" Click="InsertTemplate_Click" />
                <ui:Button Content="∑" Tag="\sum_{i=1}^{n} " Click="InsertTemplate_Click" />
                <ui:Button Content="∫" Tag="\int_{a}^{b} " Click="InsertTemplate_Click" />
                <ui:Button Content="lim" Tag="\lim_{x \to \infty} " Click="InsertTemplate_Click" />
                <ui:Button Content="α" Tag="\alpha" Click="InsertTemplate_Click" />
                <ui:Button Content="β" Tag="\beta" Click="InsertTemplate_Click" />
                <ui:Button Content="θ" Tag="\theta" Click="InsertTemplate_Click" />
                <ui:Button Content="π" Tag="\pi" Click="InsertTemplate_Click" />
                <ui:Button Content="Δ" Tag="\Delta" Click="InsertTemplate_Click" />
                <ui:Button Content="∞" Tag="\infty" Click="InsertTemplate_Click" />
                <ui:Button Content="±" Tag="\pm" Click="InsertTemplate_Click" />
                <ui:Button Content="≤" Tag="\leq" Click="InsertTemplate_Click" />
                <ui:Button Content="≥" Tag="\geq" Click="InsertTemplate_Click" />
                <ui:Button Content="≠" Tag="\neq" Click="InsertTemplate_Click" />
                <ui:Button Content="≈" Tag="\approx" Click="InsertTemplate_Click" />
                <ui:Button Content="→" Tag="\rightarrow" Click="InsertTemplate_Click" />
            </WrapPanel>

            <ui:TextBox x:Name="FormulaBox"
                        Grid.Row="2"
                        PlaceholderText="Type equation (e.g., x = \frac{-b \pm \sqrt{b^2 - 4ac}}{2a})"
                        FontFamily="Consolas, Segoe UI"
                        FontSize="14"
                        TextChanged="FormulaBox_TextChanged"
                        Margin="0,0,0,12" />

            <Border Grid.Row="3"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Padding="16">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="Both"
                              PanningDeceleration="0.001"
                              PanningRatio="1.0"
                              IsManipulationEnabled="True">
                    <Image x:Name="PreviewImage"
                           Stretch="None"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="Cancel_Click" />
                <ui:Button Content="Insert Equation into Note" Appearance="Primary" Click="Insert_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

