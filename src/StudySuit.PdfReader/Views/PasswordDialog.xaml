<ui:FluentWindow x:Class="StudySuit.PdfReader.Views.PasswordDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Encrypted PDF"
                 Width="420"
                 Height="250"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Password Required"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Grid.Row="0" />

        <StackPanel Grid.Row="1" Margin="24,12,24,20" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:SymbolIcon Symbol="LockClosed24" FontSize="20" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="PromptLabel"
                           Text="Enter the password to unlock this PDF."
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="ErrorLabel"
                       Text="Incorrect password. Please try again."
                       Foreground="#FFFF6B6B"
                       FontSize="12"
                       Margin="0,0,0,8"
                       Visibility="Collapsed" />

            <ui:PasswordBox x:Name="PasswordInput"
                            PlaceholderText="Document password"
                            Margin="0,4,0,16"
                            KeyDown="PasswordInput_KeyDown" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel"
                           Appearance="Secondary"
                           Margin="0,0,10,0"
                           Click="CancelButton_Click" />
                <ui:Button Content="Unlock"
                           Appearance="Primary"
                           Click="UnlockButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

