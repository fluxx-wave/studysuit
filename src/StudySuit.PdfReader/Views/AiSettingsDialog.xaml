<ui:FluentWindow x:Class="StudySuit.PdfReader.Views.AiSettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:StudySuit.PdfReader.Models"
                 Title="AI Assistant &amp; Model Settings"
                 Width="800"
                 Height="750"
                 MinWidth="660"
                 MinHeight="620"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="AI Assistant &amp; Model Settings"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Grid.Row="0" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,10,24,12">
            <StackPanel>
                <!-- Section 1: Model Provider & Endpoint -->
                <TextBlock Text="Model Provider &amp; Endpoint" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                <Border Padding="16"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Provider Preset" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="ProviderBox"
                                  ItemsSource="{x:Static models:AiProviderDefaults.Presets}"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="ProviderBox_SelectionChanged"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="Base URL" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="BaseUrlBox"
                                    PlaceholderText="e.g., http://localhost:11434 or https://api.openai.com/v1"
                                    Margin="0,0,0,12" />

                        <TextBlock Text="Model Name" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModelBox"
                                      Grid.Column="0"
                                      IsEditable="True"
                                      ToolTip="Type any model ID or click Fetch Models to list installed/available models" />
                            <ui:Button x:Name="FetchModelsButton"
                                       Grid.Column="1"
                                       Appearance="Secondary"
                                       Margin="8,0,0,0"
                                       Padding="12,7"
                                       Click="FetchModelsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Fetch Models" FontSize="12" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="ApiKeyHint"
                                       DockPanel.Dock="Right"
                                       Text="Optional for local models"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold" />
                        </DockPanel>
                        <ui:PasswordBox x:Name="ApiKeyBox"
                                        PlaceholderText="Enter provider API key (encrypted locally per user)" />
                    </StackPanel>
                </Border>

                <!-- Local LLM Connection & Presets Card -->
                <Border Padding="16"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Laptop24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Local LLM Connection &amp; Quick Presets" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Run your preferred local AI server on your machine, then click a preset below or click 'Fetch Models' above to connect:"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <WrapPanel Margin="0,0,0,8">
                            <ui:Button x:Name="PresetOllamaButton"
                                       Appearance="Secondary"
                                       Padding="10,5"
                                       Margin="0,0,8,6"
                                       Click="PresetOllamaButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Server24" FontSize="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Ollama (:11434)" FontSize="11.5" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="PresetLmStudioButton"
                                       Appearance="Secondary"
                                       Padding="10,5"
                                       Margin="0,0,8,6"
                                       Click="PresetLmStudioButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Desktop24" FontSize="13" Margin="0,0,5,0" />
                                    <TextBlock Text="LM Studio (:1234)" FontSize="11.5" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="PresetLlamaCppButton"
                                       Appearance="Secondary"
                                       Padding="10,5"
                                       Margin="0,0,8,6"
                                       Click="PresetLlamaCppButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Code24" FontSize="13" Margin="0,0,5,0" />
                                    <TextBlock Text="llama.cpp (:8080)" FontSize="11.5" />
                                </StackPanel>
                            </ui:Button>
                        </WrapPanel>

                        <TextBlock Text="• Ollama: Run 'ollama run llama3.2' in terminal (default: http://localhost:11434)&#x0a;• LM Studio: Start Local Server in the Developer tab (default: http://localhost:1234/v1)&#x0a;• llama.cpp: Run 'llama-server.exe -m model.gguf --port 8080' (default: http://localhost:8080/v1)"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Section 2: Generation, Personality & Response Format -->
                <TextBlock Text="Generation, Personality &amp; Response Format" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                <Border Padding="16"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="TempLabel" DockPanel.Dock="Right" Text="0.4" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="Temperature" FontSize="12" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider x:Name="TemperatureSlider"
                                        Minimum="0"
                                        Maximum="1.5"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="TemperatureSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max Tokens" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="MaxTokensBox" Text="2048" />
                            </StackPanel>
                        </Grid>

                        <!-- Exam / Persona Preset, Answer Length & Voice Readout -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="185" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Personalisation / Exam Preset" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="PersonaPresetBox"
                                          ItemsSource="{x:Static models:AiPersonalisationDefaults.PersonaPresets}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Kind"
                                          SelectionChanged="PersonaPresetBox_SelectionChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Answer Length" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="AnswerLengthBox"
                                          ItemsSource="{x:Static models:AiPersonalisationDefaults.AnswerLengths}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Length" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Voice Mode" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="VoiceModeBox"
                                          ItemsSource="{x:Static models:AiPersonalisationDefaults.VoiceModes}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Mode" />
                            </StackPanel>
                        </Grid>

                        <!-- Voice Engine, Pitch, Speed & Preview -->
                        <Border Padding="14"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <ui:Button x:Name="PreviewVoiceButton"
                                               DockPanel.Dock="Right"
                                               Appearance="Secondary"
                                               Padding="10,5"
                                               Click="PreviewVoiceButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon x:Name="PreviewVoiceIcon" Symbol="Speaker224" FontSize="15" Margin="0,0,6,0" />
                                            <TextBlock x:Name="PreviewVoiceLabel" Text="Preview Voice" FontSize="12" />
                                        </StackPanel>
                                    </ui:Button>
                                    <TextBlock Text="Voice Model &amp; Speech Controls" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Voice Model Selection -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Voice Model / Synthesis Engine" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ComboBox x:Name="VoiceModelBox"
                                                  IsEditable="True"
                                                  SelectionChanged="VoiceModelBox_SelectionChanged"
                                                  ToolTip="Select Instagram Reels viral voice, Google Neural, or any installed Windows SAPI voice" />
                                    </StackPanel>

                                    <!-- Speed & Pitch Sliders -->
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Speed -->
                                        <StackPanel Grid.Column="0">
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock x:Name="VoiceSpeedLabel" DockPanel.Dock="Right" Text="1.0x" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="Speed" FontSize="11.5" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <Slider x:Name="VoiceSpeedSlider"
                                                    Minimum="0.5"
                                                    Maximum="2.0"
                                                    TickFrequency="0.1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="VoiceSpeedSlider_ValueChanged" />
                                        </StackPanel>

                                        <!-- Pitch -->
                                        <StackPanel Grid.Column="2">
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock x:Name="VoicePitchLabel" DockPanel.Dock="Right" Text="0 (Neutral)" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="Pitch" FontSize="11.5" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <Slider x:Name="VoicePitchSlider"
                                                    Minimum="-10"
                                                    Maximum="10"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="VoicePitchSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Side-by-side Personality & Response Format Spec -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.25*" />
                            </Grid.ColumnDefinitions>

                            <!-- Personality / Persona -->
                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,4">
                                    <ui:Button DockPanel.Dock="Right"
                                               Appearance="Transparent"
                                               Padding="6,2"
                                               FontSize="11"
                                               Content="Reset Default"
                                               Click="ResetPersonality_Click" />
                                    <TextBlock Text="Personality (System Prompt)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Tone, teaching style, and study behavior."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,6" />
                                <TextBox x:Name="SystemPromptBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="180"
                                         Padding="8"
                                         FontSize="12"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>

                            <!-- Response Format Spec -->
                            <StackPanel Grid.Column="2">
                                <DockPanel Margin="0,0,0,4">
                                    <ui:Button DockPanel.Dock="Right"
                                               Appearance="Transparent"
                                               Padding="6,2"
                                               FontSize="11"
                                               Content="Reset Spec"
                                               Click="ResetResponseFormat_Click" />
                                    <TextBlock Text="Response Format (Charts &amp; Advanced UI)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <CheckBox x:Name="IncludeResponseFormatCheck"
                                          Content="Send Response Format spec beside Personality"
                                          FontSize="11.5"
                                          Margin="0,0,0,6"
                                          Checked="IncludeResponseFormatCheck_Changed"
                                          Unchecked="IncludeResponseFormatCheck_Changed" />
                                <TextBox x:Name="ResponseFormatBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas, Courier New"
                                         FontSize="11"
                                         Height="160"
                                         Padding="8"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Internet Research -->
                <TextBlock Text="Internet Research" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                <Border Padding="16"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="UseInternetCheck"
                                  Content="Enable Internet Research by default in AI chat"
                                  Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Web Search Provider" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="SearchProviderBox" SelectionChanged="SearchProviderBox_SelectionChanged">
                                    <ComboBoxItem Content="Built-in Web (DuckDuckGo + Wikipedia — No Key)" Tag="BuiltInWeb" IsSelected="True" />
                                    <ComboBoxItem Content="Tavily Search API (Requires Key)" Tag="Tavily" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max Sources" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="MaxResultsBox">
                                    <ComboBoxItem Content="2" Tag="2" />
                                    <ComboBoxItem Content="4" Tag="4" IsSelected="True" />
                                    <ComboBoxItem Content="6" Tag="6" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="SearchKeyPanel" Visibility="Collapsed">
                            <TextBlock Text="Search API Key (Tavily)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ui:PasswordBox x:Name="SearchApiKeyBox" PlaceholderText="tvly-..." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Connection Test Feedback -->
                <TextBlock x:Name="TestStatusText"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Margin="2,2,2,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2"
                Padding="24,12,24,18"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <ui:Button x:Name="TestButton"
                           DockPanel.Dock="Left"
                           Appearance="Secondary"
                           Click="TestButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PlugConnected24" FontSize="15" Margin="0,0,6,0" />
                        <TextBlock Text="Test Connection" />
                    </StackPanel>
                </ui:Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="Cancel_Click" />
                    <ui:Button Content="Save Settings" Appearance="Primary" Click="Save_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

