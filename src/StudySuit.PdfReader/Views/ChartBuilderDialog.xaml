<ui:FluentWindow x:Class="StudySuit.PdfReader.Views.ChartBuilderDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Chart &amp; Graph Studio"
                 Width="880"
                 Height="560"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Chart &amp; Graph Studio"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20,10,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Left Config Panel -->
            <ScrollViewer Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Chart Type" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="ChartTypeBox"
                              SelectionChanged="ChartTypeBox_SelectionChanged"
                              Margin="0,0,0,10">
                        <ComboBoxItem Content="Bar Chart" Tag="Bar" IsSelected="True" />
                        <ComboBoxItem Content="Line Graph" Tag="Line" />
                        <ComboBoxItem Content="Pie Chart" Tag="Pie" />
                        <ComboBoxItem Content="Scatter Plot" Tag="Scatter" />
                        <ComboBoxItem Content="Function Graph  y = f(x)" Tag="FunctionPlot" />
                    </ComboBox>

                    <TextBlock Text="Title" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="TitleBox"
                                Text="Weekly Study Hours"
                                TextChanged="Input_Changed"
                                Margin="0,0,0,10" />

                    <!-- Data Points Panel (for Bar / Line / Pie / Scatter) -->
                    <StackPanel x:Name="DataPanel">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="X Axis Label" FontSize="11.5" Margin="0,0,0,3" />
                                <ui:TextBox x:Name="XLabelBox" Text="Day" TextChanged="Input_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y Axis Label" FontSize="11.5" Margin="0,0,0,3" />
                                <ui:TextBox x:Name="YLabelBox" Text="Hours" TextChanged="Input_Changed" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Data Rows (Label, Value  or  Label, X, Y for Scatter)"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="DataRowsBox"
                                 AcceptsReturn="True"
                                 Height="185"
                                 FontFamily="Consolas, Segoe UI"
                                 FontSize="12.5"
                                 Padding="8"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="Input_Changed" />
                    </StackPanel>

                    <!-- Function Plot Panel -->
                    <StackPanel x:Name="FunctionPanel" Visibility="Collapsed">
                        <TextBlock Text="Function Expression  f(x)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="FunctionExprBox"
                                    Text="sin(x) * 2 + cos(2*x)"
                                    FontFamily="Consolas, Segoe UI"
                                    TextChanged="Input_Changed"
                                    Margin="0,0,0,8" />

                        <TextBlock Text="Supports: + - * / ^, sin, cos, tan, sqrt, abs, ln, log, exp, pi, e"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="X Min" FontSize="11.5" Margin="0,0,0,3" />
                                <ui:TextBox x:Name="XMinBox" Text="-10" TextChanged="Input_Changed" />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="X Max" FontSize="11.5" Margin="0,0,0,3" />
                                <ui:TextBox x:Name="XMaxBox" Text="10" TextChanged="Input_Changed" />
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Y Min" FontSize="11.5" Margin="0,0,0,3" />
                                <ui:TextBox x:Name="YMinBox" Text="-5" TextChanged="Input_Changed" />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Y Max" FontSize="11.5" Margin="0,0,0,3" />
                                <ui:TextBox x:Name="YMaxBox" Text="5" TextChanged="Input_Changed" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Live Preview -->
            <Border Grid.Column="2"
                    Grid.Row="0"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Padding="12">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>

            <!-- Bottom Actions -->
            <StackPanel Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="Cancel_Click" />
                <ui:Button Content="Insert Chart into Note" Appearance="Primary" Click="Insert_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

