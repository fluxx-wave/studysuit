<ui:FluentWindow x:Class="StudySuit.PdfReader.Views.NoteEditorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Annotation Note"
                 Width="440"
                 Height="300"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="DialogTitleBar"
                     Title="Annotation Note"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20,10,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SubtitleLabel"
                       Grid.Row="0"
                       Text="Enter note or text:"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <TextBox x:Name="NoteInputBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10"
                     FontSize="13.5"
                     VerticalContentAlignment="Top" />

            <DockPanel Grid.Row="2" Margin="0,14,0,0">
                <ui:Button x:Name="DeleteButton"
                           DockPanel.Dock="Left"
                           Content="Delete"
                           Appearance="Danger"
                           Visibility="Collapsed"
                           Click="DeleteButton_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel"
                               Appearance="Secondary"
                               Margin="0,0,8,0"
                               Click="CancelButton_Click" />
                    <ui:Button Content="Save"
                               Appearance="Primary"
                               Click="SaveButton_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

