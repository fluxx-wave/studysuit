<ui:FluentWindow x:Class="StudySuit.PdfReader.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:StudySuit.PdfReader.Models"
                 xmlns:vm="clr-namespace:StudySuit.PdfReader.ViewModels"
                 xmlns:controls="clr-namespace:StudySuit.PdfReader.Controls"
                 mc:Ignorable="d"
                 Title="StudySuit PDF Reader"
                 Width="1180"
                 Height="720"
                 MinWidth="540"
                 MinHeight="460"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 AllowDrop="True"
                 Drop="Window_Drop"
                 DragOver="Window_DragOver"
                 PreviewKeyDown="Window_PreviewKeyDown"
                 SizeChanged="MainWindow_SizeChanged">

    <Window.Resources>
        <Style x:Key="ThemedCardButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentCalendarDayStyle" TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="1" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Custom Fluent TitleBar -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="StudySuit PDF"
                     Height="38"
                     Visibility="{Binding IsFullScreen, Converter={StaticResource InverseBoolToVis}}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ToggleButton IsChecked="{Binding IsAiSidebarOpen, Mode=TwoWay}"
                                  Padding="10,4"
                                  Margin="0,0,4,0"
                                  BorderThickness="1"
                                  BorderBrush="Transparent"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  ToolTip="Toggle AI Study Assistant Sidebar">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BotSparkle24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="AI Assistant" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ui:Button Appearance="Transparent"
                               Padding="8,4"
                               Margin="0,0,2,0"
                               ToolTip="AI Assistant &amp; Model Settings"
                               Command="{Binding OpenAiSettingsCommand}">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="8,4"
                               ToolTip="Toggle Light / Dark Theme"
                               Command="{Binding ToggleThemeCommand}">
                        <ui:SymbolIcon Symbol="{Binding IsDarkTheme, Converter={StaticResource ThemeIcon}}" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Row 1: Persistent Tab Strip with Pinned Home Dashboard Tab -->
        <Border Grid.Row="1"
                Padding="10,4"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Visibility="{Binding IsFullScreen, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right"
                           Appearance="Transparent"
                           Padding="10,5"
                           ToolTip="Open PDF (Ctrl+O)"
                           Command="{Binding OpenFileDialogCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="14" />
                        <TextBlock Text="Open PDF" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Pinned Home Dashboard Button -->
                <RadioButton GroupName="MainWorkspaceTabs"
                             DockPanel.Dock="Left"
                             IsChecked="{Binding IsHomeActive, Mode=TwoWay}"
                             Command="{Binding ShowHomeCommand}"
                             Margin="0,0,8,0"
                             Padding="12,5"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Cursor="Hand"
                             ToolTip="Home Study Dashboard">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="HomeTabBorder"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Home24" FontSize="15" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Home" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HomeTabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HomeTabBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                <Setter TargetName="HomeTabBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>

                <!-- Pinned Notes Studio Tab Button -->
                <RadioButton GroupName="MainWorkspaceTabs"
                             DockPanel.Dock="Left"
                             IsChecked="{Binding IsNotesActive, Mode=TwoWay}"
                             Command="{Binding ShowNotesCommand}"
                             Margin="0,0,6,0"
                             Padding="12,5"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Cursor="Hand"
                             ToolTip="Note-Taking Studio (Handwriting, Equations, Charts &amp; Pictures)">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="NotesTabBorder"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Notebook24" FontSize="15" Margin="0,0,6,0" Foreground="#FF4ADE80" />
                                                <TextBlock Text="Notes" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NotesTabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="NotesTabBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                <Setter TargetName="NotesTabBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>

                <!-- Pinned News & Current Affairs Feed Tab Button -->
                <RadioButton GroupName="MainWorkspaceTabs"
                             DockPanel.Dock="Left"
                             IsChecked="{Binding IsFeedActive, Mode=TwoWay}"
                             Command="{Binding ShowFeedCommand}"
                             Margin="0,0,8,0"
                             Padding="12,5"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Cursor="Hand"
                             ToolTip="Daily, Weekly &amp; Monthly News Feed">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="FeedTabBorder"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="News24" FontSize="15" Margin="0,0,6,0" Foreground="#FF38BDF8" />
                                                <TextBlock Text="Feed" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FeedTabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="FeedTabBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                <Setter TargetName="FeedTabBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>

                <!-- NCERT Books Library Tab Button -->
                <RadioButton GroupName="MainWorkspaceTabs"
                             DockPanel.Dock="Left"
                             IsChecked="{Binding IsLibraryActive, Mode=TwoWay}"
                             Command="{Binding ShowLibraryCommand}"
                             Margin="0,0,8,0"
                             Padding="12,5"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Cursor="Hand"
                             ToolTip="NCERT Textbooks Library (Class 6–12 • Direct Download &amp; Read)">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="LibraryTabBorder"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Library24" FontSize="15" Margin="0,0,6,0" Foreground="#FFA78BFA" />
                                                <TextBlock Text="NCERT Library" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="LibraryTabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="LibraryTabBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                <Setter TargetName="LibraryTabBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>

                <!-- Open Document Tabs -->
                <ListBox ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabBorder"
                                                CornerRadius="6"
                                                Padding="10,5"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="DocumentTab_MouseLeftButtonDown">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.IsHomeActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DocumentTabViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="14" Margin="0,0,7,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding TabTitle}"
                                           FontSize="12.5"
                                           FontWeight="Medium"
                                           MaxWidth="200"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <ui:Button Appearance="Transparent"
                                           Padding="4"
                                           Margin="8,0,0,0"
                                           ToolTip="Close Tab (Ctrl+W)"
                                           Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                </ui:Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Row 2: Active Event Reminder Notification Banner (visible across Home & Reader when reminders are due) -->
        <Border x:Name="ReminderBannerBorder"
                Grid.Row="2"
                Padding="14,8"
                BorderThickness="0,0,0,1"
                BorderBrush="#FFF59E0B"
                Background="#28F59E0B"
                Visibility="{Binding HasActiveReminders, Converter={StaticResource BoolToVis}}"
                IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <ItemsControl ItemsSource="{Binding ActiveReminders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:StudyEvent}">
                        <DockPanel Margin="0,2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary"
                                           Padding="10,4"
                                           Margin="0,0,6,0"
                                           Command="{Binding DataContext.SnoozeReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="AlertSnooze24" FontSize="14" Margin="0,0,5,0" />
                                        <TextBlock Text="Snooze 5m" FontSize="11.5" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Appearance="Primary"
                                           Padding="10,4"
                                           Command="{Binding DataContext.DismissReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}">
                                    <TextBlock Text="Dismiss" FontSize="11.5" />
                                </ui:Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="AlertOn24" FontSize="18" Foreground="#FFF59E0B" Margin="0,0,10,0" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <Run Text="Reminder: " />
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding DateAndTimeDisplay, StringFormat='  •  {0}'}"
                                           FontSize="12"
                                           Opacity="0.82"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Row 3: Main Viewer Command Toolbar -->
        <Border Grid.Row="3"
                Padding="12,5"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ApplicationBackgroundBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowDocumentReader}" Value="True" />
                                <Condition Binding="{Binding IsFullScreen}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid DataContext="{Binding SelectedTab}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Group: Sidebar & Page Nav -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Transparent"
                               Padding="8,6"
                               ToolTip="Toggle Sidebar (Pages, Outline, Search, Notes)"
                               Command="{Binding DataContext.ToggleSidebarCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ui:SymbolIcon Symbol="PanelLeft24" FontSize="17" />
                    </ui:Button>

                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Previous Page"
                               Command="{Binding PreviousPageCommand}">
                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                    </ui:Button>

                    <TextBox x:Name="PageInputBox"
                             Text="{Binding PageNumberInput, UpdateSourceTrigger=PropertyChanged}"
                             Width="48"
                             Height="28"
                             FontSize="12.5"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Margin="4,0"
                             ToolTip="Jump to page number"
                             KeyDown="PageInputBox_KeyDown"
                             LostFocus="PageInputBox_LostFocus" />

                    <TextBlock Text="{Binding PageCount, StringFormat='/ {0}'}"
                               FontSize="12.5"
                               Opacity="0.75"
                               VerticalAlignment="Center"
                               Margin="2,0,4,0" />

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Next Page"
                               Command="{Binding NextPageCommand}">
                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" />
                    </ui:Button>
                </StackPanel>

                <!-- Center Group: Zoom & View Modes -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Zoom Out (Ctrl+-)"
                               Command="{Binding ZoomOutCommand}">
                        <ui:SymbolIcon Symbol="ZoomOut24" FontSize="17" />
                    </ui:Button>

                    <Border Padding="8,4"
                            Margin="2,0"
                            CornerRadius="5"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding ZoomPercent, StringFormat='{}{0:0}%'}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   MinWidth="42"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Zoom In (Ctrl++)"
                               Command="{Binding ZoomInCommand}">
                        <ui:SymbolIcon Symbol="ZoomIn24" FontSize="17" />
                    </ui:Button>

                    <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <ui:Button Appearance="Transparent"
                               Padding="8,6"
                               ToolTip="Fit Width"
                               Command="{Binding SetFitWidthCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AutoFitWidth24" FontSize="16" />
                            <TextBlock Text="Fit Width" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="8,6"
                               Margin="2,0,0,0"
                               ToolTip="Fit Single Page"
                               Command="{Binding SetFitPageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PageFit24" FontSize="16" />
                            <TextBlock Text="Fit Page" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="8,6"
                               Margin="2,0,0,0"
                               ToolTip="Toggle Continuous Scroll / Single Page View"
                               Command="{Binding ToggleViewModeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentOnePageMultiple24" FontSize="16" />
                            <TextBlock Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Continuous" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSinglePageMode}" Value="True">
                                                <Setter Property="Text" Value="Single Page" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <!-- Right Group: Rotate, Markup Toggle, Night Reading, Search, Copy, Export, Print, Info, Fullscreen -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Rotate Counter-Clockwise 90°"
                               Command="{Binding RotateLeftCommand}">
                        <ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" FontSize="16" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Rotate Clockwise 90°"
                               Command="{Binding RotateRightCommand}">
                        <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="16" />
                    </ui:Button>

                    <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <ToggleButton IsChecked="{Binding IsAnnotationBarVisible}"
                                  Padding="8,5"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  ToolTip="Show / Hide Annotation &amp; Highlighting Toolbar">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Highlight24" FontSize="16" />
                            <TextBlock Text="Annotate" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton IsChecked="{Binding IsNightReadingMode}"
                                  Padding="7,6"
                                  Margin="2,0,0,0"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  ToolTip="Night Reading Mode (Invert PDF page colors)">
                        <ui:SymbolIcon Symbol="Eye24" FontSize="16" />
                    </ToggleButton>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               Margin="2,0,0,0"
                               ToolTip="Read Current PDF Page Aloud (Uses selected Voice / Hindi mode)"
                               Command="{Binding DataContext.ReadCurrentPdfPageAloudCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               Visibility="{Binding DataContext.IsSpeakingCurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Speaker224" FontSize="16" Foreground="#FF38BDF8" />
                            <TextBlock Text="Read" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               Margin="2,0,0,0"
                               ToolTip="Stop Reading PDF"
                               Command="{Binding DataContext.StopPdfSpeechCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               Visibility="{Binding DataContext.IsSpeakingCurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Stop24" FontSize="16" Foreground="#FFF87171" />
                            <TextBlock Text="Stop" FontSize="11.5" Foreground="#FFF87171" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               Margin="2,0,0,0"
                               ToolTip="Find in Document (Ctrl+F)"
                               Command="{Binding DataContext.ToggleSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ui:SymbolIcon Symbol="Search24" FontSize="16" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Copy Current Page Text"
                               Command="{Binding DataContext.CopyCurrentPageTextCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Export Current Page as PNG"
                               Command="{Binding DataContext.ExportCurrentPagePngCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ui:SymbolIcon Symbol="Image24" FontSize="16" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Print Document"
                               Click="PrintButton_Click">
                        <ui:SymbolIcon Symbol="DocumentPrint24" FontSize="16" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Document Properties"
                               Command="{Binding DataContext.TogglePropertiesCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="16" />
                    </ui:Button>

                    <ui:Button Appearance="Transparent"
                               Padding="7,6"
                               ToolTip="Fullscreen Mode (F11)"
                               Command="{Binding DataContext.ToggleFullScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ui:SymbolIcon Symbol="{Binding DataContext.IsFullScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FullScreenIcon}}" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 4: Dedicated Annotation, Highlighting & Markup Toolbar -->
        <Border Grid.Row="4"
                Padding="12,5"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                DataContext="{Binding SelectedTab}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.ShowDocumentReader, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                <Condition Binding="{Binding DataContext.IsFullScreen, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                <Condition Binding="{Binding IsAnnotationBarVisible}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <WrapPanel.Resources>
                    <Style x:Key="ToolPillStyle" TargetType="RadioButton">
                        <Setter Property="GroupName" Value="AnnotationToolGroup" />
                        <Setter Property="Margin" Value="0,0,3,0" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="PillBorder"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </WrapPanel.Resources>

                <!-- Pointer & Word-Selection Tools -->
                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Pan}"
                             ToolTip="Pan / View Mode (Hold Alt + Drag across words to quick-copy)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Cursor24" FontSize="15" />
                        <TextBlock Text="Hand" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=SelectText}"
                             ToolTip="Select Words &amp; Copy Text">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextT24" FontSize="15" />
                        <TextBlock Text="Select" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <!-- Circle to Search with AI -->
                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=CircleToSearch}"
                             ToolTip="Circle to Search with AI (Draw a freehand circle or lasso around any text, formula, or diagram to ask AI)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BotSparkle24" FontSize="15" Foreground="#FF38BDF8" />
                        <TextBlock Text="Circle to Search" Margin="5,0,0,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- Word-Selection Text Markup Tools -->
                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Highlight}"
                             ToolTip="Highlight Words (Hold left mouse button &amp; drag across words)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Highlight24" FontSize="15" />
                        <TextBlock Text="Highlight" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Underline}"
                             ToolTip="Underline Words (Hold left mouse button &amp; drag across words)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextUnderline24" FontSize="15" />
                        <TextBlock Text="Underline" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Strikethrough}"
                             ToolTip="Strikethrough Words (Hold left mouse button &amp; drag across words)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextStrikethrough24" FontSize="15" />
                        <TextBlock Text="Strike" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- Freehand Paint Brush, Ink & Shapes -->
                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Brush}"
                             ToolTip="Paint Brush Highlighter (Hold left mouse button &amp; paint anywhere like MS Paint)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PaintBrush24" FontSize="15" />
                        <TextBlock Text="Brush" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Ink}"
                             ToolTip="Freehand Ink Pen">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="InkingTool24" FontSize="15" />
                        <TextBlock Text="Draw" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Rectangle}"
                             ToolTip="Rectangle Callout">
                    <ui:SymbolIcon Symbol="Square24" FontSize="15" />
                </RadioButton>

                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Ellipse}"
                             ToolTip="Circle / Ellipse Callout">
                    <ui:SymbolIcon Symbol="Circle24" FontSize="15" />
                </RadioButton>

                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Arrow}"
                             ToolTip="Arrow Callout">
                    <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="15" />
                </RadioButton>

                <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- Notes, Text Callout & Eraser -->
                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=StickyNote}"
                             ToolTip="Add Sticky Note Comment">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CommentNote24" FontSize="15" />
                        <TextBlock Text="Note" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=TextBox}"
                             ToolTip="Add Text Callout on Page">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DrawText24" FontSize="15" />
                        <TextBlock Text="Text" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource ToolPillStyle}"
                             IsChecked="{Binding ActiveTool, Converter={StaticResource EnumEqual}, ConverterParameter=Eraser}"
                             ToolTip="Eraser (Click any annotation to delete)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="EraserTool24" FontSize="15" />
                        <TextBlock Text="Erase" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- Color Swatch Picker -->
                <ItemsControl ItemsSource="{x:Static vm:DocumentTabViewModel.ColorPalette}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="0"
                                    Margin="2,0"
                                    Width="22"
                                    Height="22"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Select Annotation Color"
                                    Command="{Binding DataContext.SelectedTab.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Border Width="20"
                                        Height="20"
                                        CornerRadius="10"
                                        BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource StringEqualMulti}">
                                                            <Binding Path="." />
                                                            <Binding Path="DataContext.SelectedTab.SelectedColorHex" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Ellipse Width="14" Height="14" Fill="{Binding Converter={StaticResource HexToBrush}}" />
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- Stroke Thickness Presets -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Transparent" Padding="6,4" ToolTip="Thin Stroke (2px)" Command="{Binding SetStrokeWidthCommand}">
                        <ui:Button.CommandParameter>
                            <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">2</System:Double>
                        </ui:Button.CommandParameter>
                        <Border Width="14" Height="2" Background="{DynamicResource TextFillColorPrimaryBrush}" CornerRadius="1" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Padding="6,4" ToolTip="Medium Stroke (4px)" Command="{Binding SetStrokeWidthCommand}">
                        <ui:Button.CommandParameter>
                            <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">4</System:Double>
                        </ui:Button.CommandParameter>
                        <Border Width="14" Height="4" Background="{DynamicResource TextFillColorPrimaryBrush}" CornerRadius="2" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Padding="6,4" ToolTip="Bold Stroke (7px)" Command="{Binding SetStrokeWidthCommand}">
                        <ui:Button.CommandParameter>
                            <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">7</System:Double>
                        </ui:Button.CommandParameter>
                        <Border Width="14" Height="7" Background="{DynamicResource TextFillColorPrimaryBrush}" CornerRadius="3" />
                    </ui:Button>
                </StackPanel>

                <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <!-- Undo, Redo, Clear Page, Export Study Notes -->
                <ui:Button Appearance="Transparent"
                           Padding="6,5"
                           ToolTip="Undo Annotation (Ctrl+Z)"
                           IsEnabled="{Binding CanUndo}"
                           Command="{Binding UndoCommand}">
                    <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="15" />
                </ui:Button>

                <ui:Button Appearance="Transparent"
                           Padding="6,5"
                           ToolTip="Redo Annotation (Ctrl+Y)"
                           IsEnabled="{Binding CanRedo}"
                           Command="{Binding RedoCommand}">
                    <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="15" />
                </ui:Button>

                <ui:Button Appearance="Transparent"
                           Padding="6,5"
                           ToolTip="Clear Annotations on Current Page"
                           Command="{Binding ClearCurrentPageAnnotationsCommand}">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                </ui:Button>

                <ui:Button Appearance="Transparent"
                           Padding="8,5"
                           Margin="2,0,0,0"
                           ToolTip="Export All Annotations &amp; Notes to Markdown (.md)"
                           Command="{Binding DataContext.ExportAnnotationsMarkdownCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentSave24" FontSize="15" />
                        <TextBlock Text="Export Notes" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </WrapPanel>
        </Border>

        <!-- Row 5: Main Content Area + Collapsible Right AI Assistant Sidebar -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="AiSidebarColumn" MinWidth="0">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowAiSidebar}" Value="True">
                                    <Setter Property="Width" Value="420" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
            <!-- 5A. DEFAULT HOME STUDY SUITE DASHBOARD -->
            <Grid x:Name="HomeDashboardRoot"
                  Visibility="{Binding ShowHomeDashboard, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                  IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PanningMode="Both"
                              PanningDeceleration="0.001"
                              PanningRatio="1.0"
                              IsManipulationEnabled="True"
                              Padding="28,20">
                    <StackPanel MaxWidth="1360" HorizontalAlignment="Stretch">
                        <!-- Dashboard Header -->
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary"
                                           Padding="14,9"
                                           Margin="0,0,10,0"
                                           Command="{Binding OpenFolderPdfsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="17" Margin="0,0,8,0" />
                                        <TextBlock Text="Open Folder" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Appearance="Primary"
                                           Padding="18,9"
                                           Command="{Binding OpenFileDialogCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="17" Margin="0,0,8,0" />
                                        <TextBlock Text="Open PDF" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="StudySuit Home Dashboard" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Text="Track your study time, manage calendar events &amp; reminders, check off to-dos, and resume reading PDFs."
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- 5 KPI Overview Cards -->
                        <UniformGrid Columns="5" Margin="0,0,0,18">
                            <Border Margin="0,0,10,0" Padding="15,13" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Timer24" FontSize="16" Margin="0,0,7,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Today's Study" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TodayStudyTimeDisplay}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="{Binding TotalStudyTimeDisplay, StringFormat='Total: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,10,0" Padding="15,13" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="BookOpen24" FontSize="16" Margin="0,0,7,0" Foreground="#FF38BDF8" />
                                        <TextBlock Text="Documents" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalDocumentsCount}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PinnedDocumentsCount, StringFormat='{}{0} pinned'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,10,0" Padding="15,13" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Highlight24" FontSize="16" Margin="0,0,7,0" Foreground="#FF4ADE80" />
                                        <TextBlock Text="Annotations" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalAnnotationsCount}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="Highlights &amp; notes" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,10,0" Padding="15,13" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="TaskListLtr24" FontSize="16" Margin="0,0,7,0" Foreground="#FFC084FC" />
                                        <TextBlock Text="To-Do Tasks" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TodoProgressLabel}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="Study checklist" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Padding="15,13" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Calendar24" FontSize="16" Margin="0,0,7,0" Foreground="#FFF59E0B" />
                                        <TextBlock Text="Upcoming Events" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding UpcomingEventsCount}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="With reminders" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- 3-Column Bento Dashboard -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 1: Study Stopwatch + Continue Reading + Library -->
                            <StackPanel Grid.Column="0">
                                <!-- Study Stopwatch Card -->
                                <Border Margin="0,0,0,16"
                                        Padding="18"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding TodayStudyTimeDisplay, StringFormat='Today: {0}'}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Clock24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Study Stopwatch" FontSize="15.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock Text="{Binding StopwatchDisplay}"
                                                   FontSize="36"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas, Segoe UI"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,10" />

                                        <ui:TextBox PlaceholderText="Session label (e.g., Chapter 4 Review)"
                                                    Text="{Binding StopwatchSessionLabel, UpdateSourceTrigger=PropertyChanged}"
                                                    Margin="0,0,0,12" />

                                        <UniformGrid Columns="3">
                                            <ui:Button Appearance="Primary"
                                                       HorizontalAlignment="Stretch"
                                                       Margin="0,0,6,0"
                                                       Command="{Binding ToggleStopwatchCommand}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon FontSize="15" Margin="0,0,6,0">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Play24" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStopwatchRunning}" Value="True">
                                                                        <Setter Property="Symbol" Value="Pause24" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                    <TextBlock Text="{Binding StopwatchActionLabel}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </ui:Button>

                                            <ui:Button Appearance="Secondary"
                                                       HorizontalAlignment="Stretch"
                                                       Margin="0,0,6,0"
                                                       IsEnabled="{Binding CanResetOrLogStopwatch}"
                                                       Command="{Binding LogStopwatchSessionCommand}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="15" Margin="0,0,6,0" />
                                                    <TextBlock Text="Log Time" />
                                                </StackPanel>
                                            </ui:Button>

                                            <ui:Button Appearance="Transparent"
                                                       HorizontalAlignment="Stretch"
                                                       IsEnabled="{Binding CanResetOrLogStopwatch}"
                                                       Command="{Binding ResetStopwatchCommand}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="15" Margin="0,0,6,0" />
                                                    <TextBlock Text="Reset" />
                                                </StackPanel>
                                            </ui:Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Continue Reading Card -->
                                <Border Margin="0,0,0,16"
                                        Padding="16"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        Visibility="{Binding ContinueReadingItem, Converter={StaticResource NullToVis}}">
                                    <DockPanel DataContext="{Binding ContinueReadingItem}">
                                        <ui:Button DockPanel.Dock="Right"
                                                   Appearance="Primary"
                                                   Padding="14,8"
                                                   VerticalAlignment="Center"
                                                   Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}">
                                            <TextBlock Text="Resume" FontWeight="SemiBold" />
                                        </ui:Button>

                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="CONTINUE READING" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
                                            <TextBlock Text="{Binding ProgressDisplay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="5" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Recent PDF Library -->
                                <Border Padding="16"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <ui:TextBox DockPanel.Dock="Right"
                                                        Width="170"
                                                        PlaceholderText="Filter PDFs..."
                                                        Text="{Binding DashboardSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Recent PDFs" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock Text="No PDFs opened yet. Click Open PDF or drag &amp; drop a file."
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8"
                                                   Visibility="{Binding HasRecentFiles, Converter={StaticResource InverseBoolToVis}}" />

                                        <ItemsControl ItemsSource="{Binding FilteredRecentFiles}"
                                                      Visibility="{Binding HasRecentFiles, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:RecentFileItem}">
                                                    <Border Margin="0,0,0,8"
                                                            Padding="10,8"
                                                            CornerRadius="8"
                                                            BorderThickness="1"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ui:Button Appearance="Transparent" Padding="5" ToolTip="Pin / Unpin"
                                                                           Command="{Binding DataContext.TogglePinRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           CommandParameter="{Binding}">
                                                                    <ui:SymbolIcon Symbol="{Binding IsPinned, Converter={StaticResource PinIcon}}" FontSize="14" />
                                                                </ui:Button>
                                                                <ui:Button Appearance="Transparent" Padding="5" ToolTip="Remove"
                                                                           Command="{Binding DataContext.RemoveRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           CommandParameter="{Binding}">
                                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                                                                </ui:Button>
                                                            </StackPanel>

                                                            <Button Style="{StaticResource ThemedCardButtonStyle}"
                                                                    Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="24,2,0,4">
                                                                        <Run Text="{Binding ProgressDisplay, Mode=OneWay}" />
                                                                        <Run Text=" • " />
                                                                        <Run Text="{Binding AnnotationCount, Mode=OneWay}" />
                                                                        <Run Text=" notes" />
                                                                    </TextBlock>
                                                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="3" Margin="24,0,8,0" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- COLUMN 2: Study Calendar, Events & Reminders -->
                            <StackPanel Grid.Column="2">
                                <Border Padding="16"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding SelectedCalendarDateLabel}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Calendar24" FontSize="18" Margin="0,0,8,0" Foreground="#FFF59E0B" />
                                                <TextBlock Text="Study Calendar" FontSize="15.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DockPanel>

                                        <Calendar x:Name="StudyCalendar"
                                                  SelectedDate="{Binding SelectedCalendarDate, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  CalendarDayButtonStyle="{StaticResource FluentCalendarDayStyle}"
                                                  Margin="0,0,0,12" />

                                        <!-- Add Event Form -->
                                        <Border Padding="12"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Add Event &amp; Reminder" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />

                                                <ui:TextBox PlaceholderText="Event title (e.g., Physics Midterm)"
                                                            Text="{Binding NewEventTitle, UpdateSourceTrigger=PropertyChanged}"
                                                            KeyDown="NewEventInput_KeyDown"
                                                            Margin="0,0,0,8" />

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="96" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Grid.Column="0"
                                                                PlaceholderText="HH:mm"
                                                                ToolTip="Event time (24h HH:mm)"
                                                                Text="{Binding NewEventTimeText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox Grid.Column="1"
                                                              Margin="6,0"
                                                              ItemsSource="{x:Static vm:MainViewModel.EventCategories}"
                                                              SelectedItem="{Binding NewEventCategory}" />
                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{x:Static vm:MainViewModel.ReminderMinuteOptions}"
                                                              SelectedItem="{Binding NewEventReminderMinutes}"
                                                              ToolTip="Reminder minutes before event">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StringFormat='{}{0}m before'}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>

                                                <ui:Button Appearance="Primary"
                                                           HorizontalAlignment="Stretch"
                                                           Command="{Binding AddStudyEventCommand}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="CalendarAdd24" FontSize="15" Margin="0,0,6,0" />
                                                        <TextBlock Text="Schedule Event" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Events for Selected Date -->
                                        <TextBlock Text="Events on Selected Day" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Text="No events scheduled for this date."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,12"
                                                   Visibility="{Binding HasSelectedDateEvents, Converter={StaticResource InverseBoolToVis}}" />

                                        <ItemsControl ItemsSource="{Binding SelectedDateEvents}"
                                                      Visibility="{Binding HasSelectedDateEvents, Converter={StaticResource BoolToVis}}"
                                                      Margin="0,0,0,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:StudyEvent}">
                                                    <Border Margin="0,0,0,6"
                                                            Padding="10,8"
                                                            CornerRadius="8"
                                                            BorderThickness="1"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                                                        <DockPanel>
                                                            <ui:Button DockPanel.Dock="Right"
                                                                       Appearance="Transparent"
                                                                       Padding="4"
                                                                       ToolTip="Delete Event"
                                                                       Command="{Binding DataContext.DeleteStudyEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}">
                                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                                            </ui:Button>
                                                            <Ellipse Width="10" Height="10" Fill="{Binding CategoryColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0">
                                                                    <Run Text="{Binding TimeDisplay, Mode=OneWay}" />
                                                                    <Run Text=" • " />
                                                                    <Run Text="{Binding CategoryLabel, Mode=OneWay}" />
                                                                    <Run Text=" • Remind: " />
                                                                    <Run Text="{Binding ReminderLabel, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Upcoming Events Overview -->
                                        <TextBlock Text="Upcoming Schedule" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,6" />
                                        <ItemsControl ItemsSource="{Binding UpcomingEvents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:StudyEvent}">
                                                    <DockPanel Margin="0,3">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DateAndTimeDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Ellipse Width="8" Height="8" Fill="{Binding CategoryColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- COLUMN 3: Study To-Do List + Recent Highlights & Notes -->
                            <StackPanel Grid.Column="4">
                                <!-- To-Do List Card -->
                                <Border Margin="0,0,0,16"
                                        Padding="16"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <ui:Button DockPanel.Dock="Right"
                                                       Appearance="Transparent"
                                                       Padding="6,3"
                                                       ToolTip="Clear completed tasks"
                                                       Command="{Binding ClearCompletedTodosCommand}">
                                                <TextBlock Text="Clear Done" FontSize="11" />
                                            </ui:Button>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="TaskListLtr24" FontSize="18" Margin="0,0,8,0" Foreground="#FFC084FC" />
                                                <TextBlock Text="Study To-Do List" FontSize="15.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Add Todo Row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0"
                                                        PlaceholderText="New study task..."
                                                        Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                                        KeyDown="NewTodoInput_KeyDown" />
                                            <ComboBox Grid.Column="1"
                                                      Margin="6,0"
                                                      ItemsSource="{x:Static vm:MainViewModel.TodoPriorities}"
                                                      SelectedItem="{Binding NewTodoPriority}" />
                                            <ui:Button Grid.Column="2"
                                                       Appearance="Primary"
                                                       Padding="10,7"
                                                       Command="{Binding AddTodoCommand}">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                                            </ui:Button>
                                        </Grid>

                                        <!-- Filter Pills -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:Button Appearance="Secondary" Padding="8,3" Margin="0,0,6,0" Command="{Binding SetTodoFilterCommand}" CommandParameter="All">
                                                <TextBlock Text="All" FontSize="11.5" />
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Padding="8,3" Margin="0,0,6,0" Command="{Binding SetTodoFilterCommand}" CommandParameter="Active">
                                                <TextBlock Text="Active" FontSize="11.5" />
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Padding="8,3" Command="{Binding SetTodoFilterCommand}" CommandParameter="Completed">
                                                <TextBlock Text="Done" FontSize="11.5" />
                                            </ui:Button>
                                        </StackPanel>

                                        <TextBlock Text="No tasks in this view."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,6"
                                                   Visibility="{Binding HasTodos, Converter={StaticResource InverseBoolToVis}}" />

                                        <ItemsControl ItemsSource="{Binding FilteredTodos}"
                                                      Visibility="{Binding HasTodos, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:StudyTodoItem}">
                                                    <Border Margin="0,0,0,6"
                                                            Padding="8,7"
                                                            CornerRadius="8"
                                                            BorderThickness="1"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                                                        <DockPanel>
                                                            <ui:Button DockPanel.Dock="Right"
                                                                       Appearance="Transparent"
                                                                       Padding="4"
                                                                       Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}">
                                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                                            </ui:Button>

                                                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                                      Command="{Binding DataContext.ToggleTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,8,0" />

                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <Ellipse Width="7" Height="7" Fill="{Binding PriorityColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding PriorityLabel}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <TextBlock Text="{Binding DueDateDisplay, StringFormat=' • {0}'}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               Visibility="{Binding DueDateDisplay, Converter={StaticResource NullToVis}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Recent Highlights & Notes Feed -->
                                <Border Padding="16"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:SymbolIcon Symbol="Highlight24" FontSize="18" Margin="0,0,8,0" Foreground="#FF4ADE80" />
                                            <TextBlock Text="Recent Highlights &amp; Notes" FontSize="15.5" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <TextBlock Text="Highlights and sticky notes you create in PDFs appear here."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasRecentAnnotations, Converter={StaticResource InverseBoolToVis}}" />

                                        <ItemsControl ItemsSource="{Binding RecentAnnotations}"
                                                      Visibility="{Binding HasRecentAnnotations, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:RecentAnnotationSummary}">
                                                    <Button Style="{StaticResource ThemedCardButtonStyle}"
                                                            Margin="0,0,0,8"
                                                            Padding="10,8"
                                                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Command="{Binding DataContext.OpenRecentAnnotationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,3">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PageNumber, StringFormat='p.{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                <Ellipse Width="9" Height="9" Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding PreviewText}" FontSize="12" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 5B. DOCUMENT READER WORKSPACE -->
            <Grid x:Name="DocumentReaderRoot"
                  Visibility="{Binding ShowDocumentReader, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Collapsible Sidebar (4 Tabs: Pages, Outline, Search, Notes) -->
                <Border Grid.Column="0"
                        Width="280"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSidebarOpen}" Value="True" />
                                        <Condition Binding="{Binding IsFullScreen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TabControl SelectedIndex="{Binding SidebarTabIndex}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <!-- Tab 0: Thumbnails -->
                        <TabItem Header="Pages" DataContext="{Binding SelectedTab}">
                            <ListBox ItemsSource="{Binding Pages}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.PanningMode="VerticalOnly"
                                     ScrollViewer.PanningDeceleration="0.001"
                                     ScrollViewer.PanningRatio="1.0"
                                     IsManipulationEnabled="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     SelectionChanged="ThumbnailList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="8,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ThumbContainer"
                                                            Padding="8"
                                                            CornerRadius="8"
                                                            BorderThickness="2"
                                                            BorderBrush="Transparent"
                                                            Background="Transparent"
                                                            Cursor="Hand">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbContainer" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                            <Setter TargetName="ThumbContainer" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            <Setter TargetName="ThumbContainer" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PdfPageViewModel}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Background="White"
                                                    CornerRadius="4"
                                                    ClipToBounds="True"
                                                    Width="150"
                                                    MinHeight="190"
                                                    BorderThickness="1"
                                                    BorderBrush="#33808080">
                                                <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{Binding PageNumber}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0"
                                                       Opacity="0.85" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <!-- Tab 1: Bookmarks / Outline -->
                        <TabItem Header="Outline" DataContext="{Binding SelectedTab}">
                            <Grid>
                                <TextBlock Text="This PDF has no outline or table of contents."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="24"
                                           TextAlignment="Center"
                                           Visibility="{Binding HasBookmarks, Converter={StaticResource InverseBoolToVis}}" />

                                <TreeView ItemsSource="{Binding Bookmarks}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="6"
                                          ScrollViewer.PanningMode="Both"
                                          ScrollViewer.PanningDeceleration="0.001"
                                          ScrollViewer.PanningRatio="1.0"
                                          IsManipulationEnabled="True"
                                          SelectedItemChanged="BookmarkTree_SelectedItemChanged"
                                          Visibility="{Binding HasBookmarks, Converter={StaticResource BoolToVis}}">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type models:PdfBookmarkItem}" ItemsSource="{Binding Children}">
                                            <DockPanel Margin="2,4">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding PageNumber}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="8,0,4,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}" />
                                            </DockPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </TabItem>

                        <!-- Tab 2: Search Results -->
                        <TabItem Header="Search" DataContext="{Binding SelectedTab}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,4,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0"
                                                    PlaceholderText="Search text..."
                                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                    KeyDown="SidebarSearchBox_KeyDown" />
                                        <ui:Button Grid.Column="1"
                                                   Appearance="Primary"
                                                   Margin="6,0,0,0"
                                                   Padding="10,7"
                                                   Command="{Binding SearchCommand}">
                                            <ui:SymbolIcon Symbol="Search24" FontSize="15" />
                                        </ui:Button>
                                    </Grid>
                                    <TextBlock Text="{Binding SearchSummary}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="2,6,0,0" />
                                </StackPanel>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding SearchResults}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.PanningMode="VerticalOnly"
                                         ScrollViewer.PanningDeceleration="0.001"
                                         ScrollViewer.PanningRatio="1.0"
                                         IsManipulationEnabled="True"
                                         SelectionChanged="SearchResultsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SearchMatch}">
                                            <StackPanel Margin="4,4">
                                                <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Snippet}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- Tab 3: Notes & Markup Annotations Inspector -->
                        <TabItem Header="Notes" DataContext="{Binding SelectedTab}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ui:TextBox Grid.Row="0"
                                            PlaceholderText="Filter highlights &amp; notes..."
                                            Text="{Binding AnnotationFilterText, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,4,0,8" />

                                <TextBlock Grid.Row="1"
                                           Text="No annotations yet. Select Highlight, Underline, or Strike and drag across words."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="16"
                                           TextAlignment="Center"
                                           Visibility="{Binding HasAnnotations, Converter={StaticResource InverseBoolToVis}}" />

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding FilteredAnnotations}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.PanningMode="VerticalOnly"
                                         ScrollViewer.PanningDeceleration="0.001"
                                         ScrollViewer.PanningRatio="1.0"
                                         IsManipulationEnabled="True"
                                         SelectionChanged="AnnotationsList_SelectionChanged"
                                         Visibility="{Binding HasAnnotations, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:PdfAnnotation}">
                                            <Border Padding="8"
                                                    CornerRadius="8"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <ui:Button Appearance="Transparent"
                                                                       Padding="4"
                                                                       ToolTip="Edit Note / Comment"
                                                                       Tag="{Binding Id}"
                                                                       Click="EditAnnotationNote_Click">
                                                                <ui:SymbolIcon Symbol="Edit24" FontSize="12" />
                                                            </ui:Button>
                                                            <ui:Button Appearance="Transparent"
                                                                       Padding="4"
                                                                       ToolTip="Delete Annotation"
                                                                       Command="{Binding DataContext.SelectedTab.DeleteAnnotationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}">
                                                                <ui:SymbolIcon Symbol="Delete24" FontSize="12" />
                                                            </ui:Button>
                                                        </StackPanel>

                                                        <Ellipse Width="10"
                                                                 Height="10"
                                                                 Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                                 Margin="0,0,7,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <Run Text="{Binding TypeDisplay, Mode=OneWay}" />
                                                            <Run Text=" • p." />
                                                            <Run Text="{Binding PageNumber, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding SummaryText}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ui:Button Grid.Row="2"
                                           Appearance="Secondary"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,8,0,0"
                                           Command="{Binding DataContext.ExportAnnotationsMarkdownCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="DocumentSave24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Export Notes (.md)" FontSize="12" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- Resizable Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Transparent">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSidebarOpen}" Value="True" />
                                        <Condition Binding="{Binding IsFullScreen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>

                <!-- PDF Main Reading Canvas -->
                <Grid Grid.Column="2"
                      Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                      SizeChanged="Viewport_SizeChanged">

                    <ListBox x:Name="PdfPageList"
                             ItemsSource="{Binding SelectedTab.VisiblePages}"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.PanningMode="Both"
                             ScrollViewer.PanningDeceleration="0.001"
                             ScrollViewer.PanningRatio="1.0"
                             IsManipulationEnabled="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.CacheLength="2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Stylus.IsPressAndHoldEnabled="False"
                             Stylus.IsFlicksEnabled="False"
                             Loaded="PdfPageList_Loaded"
                             PreviewMouseWheel="PdfPageList_PreviewMouseWheel">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="ScrollViewer.PanningMode" Value="Both" />
                                <Setter Property="ScrollViewer.PanningDeceleration" Value="0.001" />
                                <Setter Property="ScrollViewer.PanningRatio" Value="1.0" />
                                <Setter Property="IsManipulationEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab.ActiveTool}" Value="{x:Static models:AnnotationTool.Ink}">
                                        <Setter Property="ScrollViewer.PanningMode" Value="None" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.ActiveTool}" Value="{x:Static models:AnnotationTool.Brush}">
                                        <Setter Property="ScrollViewer.PanningMode" Value="None" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.ActiveTool}" Value="{x:Static models:AnnotationTool.CircleToSearch}">
                                        <Setter Property="ScrollViewer.PanningMode" Value="None" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.ActiveTool}" Value="{x:Static models:AnnotationTool.Rectangle}">
                                        <Setter Property="ScrollViewer.PanningMode" Value="None" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.ActiveTool}" Value="{x:Static models:AnnotationTool.Ellipse}">
                                        <Setter Property="ScrollViewer.PanningMode" Value="None" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedTab.ActiveTool}" Value="{x:Static models:AnnotationTool.Arrow}">
                                        <Setter Property="ScrollViewer.PanningMode" Value="None" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,14" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="Center" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PdfPageViewModel}">
                                <Border CornerRadius="3"
                                        Background="White"
                                        BorderThickness="1"
                                        BorderBrush="#30000000"
                                        Width="{Binding DisplayWidth}"
                                        Height="{Binding DisplayHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18"
                                                          ShadowDepth="4"
                                                          Direction="270"
                                                          Opacity="0.28"
                                                          Color="Black" />
                                    </Border.Effect>

                                    <Grid x:Name="PageSurface"
                                          Background="Transparent"
                                          Stylus.IsPressAndHoldEnabled="False"
                                          Stylus.IsFlicksEnabled="False"
                                          MouseEnter="PageSurface_MouseEnter"
                                          MouseLeftButtonDown="PageSurface_MouseLeftButtonDown"
                                          MouseMove="PageSurface_MouseMove"
                                          MouseLeftButtonUp="PageSurface_MouseLeftButtonUp"
                                          LostMouseCapture="PageSurface_LostMouseCapture"
                                          PreviewTouchDown="PageSurface_PreviewTouchDown"
                                          PreviewTouchMove="PageSurface_PreviewTouchMove"
                                          PreviewTouchUp="PageSurface_PreviewTouchUp"
                                          LostTouchCapture="PageSurface_LostTouchCapture"
                                          PreviewStylusDown="PageSurface_PreviewStylusDown"
                                          PreviewStylusMove="PageSurface_PreviewStylusMove"
                                          PreviewStylusUp="PageSurface_PreviewStylusUp"
                                          LostStylusCapture="PageSurface_LostStylusCapture">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Cursor" Value="Arrow" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="SelectText">
                                                        <Setter Property="Cursor" Value="IBeam" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="Highlight">
                                                        <Setter Property="Cursor" Value="Cross" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="Underline">
                                                        <Setter Property="Cursor" Value="Cross" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="Strikethrough">
                                                        <Setter Property="Cursor" Value="Cross" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="Ink">
                                                        <Setter Property="Cursor" Value="Cross" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="Brush">
                                                        <Setter Property="Cursor" Value="Cross" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="Rectangle">
                                                        <Setter Property="Cursor" Value="Cross" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="Ellipse">
                                                        <Setter Property="Cursor" Value="Cross" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="Arrow">
                                                        <Setter Property="Cursor" Value="Cross" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedTab.ActiveTool, RelativeSource={RelativeSource AncestorType=Window}}" Value="TextBox">
                                                        <Setter Property="Cursor" Value="IBeam" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <!-- Rendered PDF Page Image -->
                                        <Image Source="{Binding RenderedImage}"
                                               Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <!-- Loading Indicator -->
                                        <ui:ProgressRing IsIndeterminate="True"
                                                         Width="36"
                                                         Height="36"
                                                         Visibility="{Binding RenderedImage, Converter={StaticResource InverseNullToVis}}" />

                                        <!-- Vector Annotations Overlay -->
                                        <ItemsControl ItemsSource="{Binding VectorAnnotations}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AnnotationVectorVisual}">
                                                    <Path Data="{Binding Geometry}"
                                                          Fill="{Binding FillBrush}"
                                                          Stroke="{Binding StrokeBrush}"
                                                          StrokeThickness="{Binding StrokeThickness}"
                                                          Opacity="{Binding Opacity}"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          ToolTip="{Binding TooltipText}"
                                                          Tag="{Binding AnnotationId}"
                                                          MouseLeftButtonDown="AnnotationVisual_MouseLeftButtonDown" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Live Word-by-Word Selection Highlight Preview -->
                                        <ItemsControl ItemsSource="{Binding LiveWordSelectionRects}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:LiveSelectionRect}">
                                                    <Border Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            CornerRadius="2"
                                                            Background="{Binding FillBrush}"
                                                            Opacity="0.42" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Pin & TextBox Annotations Overlay -->
                                        <ItemsControl ItemsSource="{Binding PinAnnotations}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AnnotationPinVisual}">
                                                    <Grid Cursor="Hand"
                                                          Tag="{Binding AnnotationId}"
                                                          MouseLeftButtonDown="AnnotationPin_MouseLeftButtonDown">
                                                        <!-- Sticky Note Badge -->
                                                        <Border Width="28"
                                                                Height="28"
                                                                CornerRadius="14"
                                                                Background="{Binding AccentBrush}"
                                                                BorderThickness="1.5"
                                                                BorderBrush="White"
                                                                ToolTip="{Binding NoteComment}"
                                                                Visibility="{Binding IsStickyNote, Converter={StaticResource BoolToVis}}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" />
                                                            </Border.Effect>
                                                            <ui:SymbolIcon Symbol="CommentNote24" FontSize="14" Foreground="#FF111111" />
                                                        </Border>

                                                        <!-- Text Callout Box -->
                                                        <Border Padding="8,4"
                                                                CornerRadius="5"
                                                                Background="#E8FFFFFF"
                                                                BorderThickness="1.5"
                                                                BorderBrush="{Binding AccentBrush}"
                                                                MaxWidth="280"
                                                                Visibility="{Binding IsTextBox, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Text}"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       FontSize="{Binding FontSize}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Search Match Highlight Overlays -->
                                        <ItemsControl ItemsSource="{Binding HighlightRects}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:HighlightRectViewModel}">
                                                    <Border Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            CornerRadius="2"
                                                            BorderThickness="1"
                                                            Background="{Binding IsActiveMatch, Converter={StaticResource HighlightFill}}"
                                                            BorderBrush="{Binding IsActiveMatch, Converter={StaticResource HighlightBorder}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Live Drawing & Shape Preview Canvas (for Ink, Rectangle, Ellipse, Arrow) -->
                                        <Canvas x:Name="PreviewOverlayCanvas" IsHitTestVisible="False">
                                            <Rectangle x:Name="PreviewRect"
                                                       Visibility="Collapsed"
                                                       Fill="Transparent"
                                                       Stroke="#FFFFE600"
                                                       StrokeThickness="2"
                                                       RadiusX="2"
                                                       RadiusY="2" />
                                            <Ellipse x:Name="PreviewEllipse"
                                                     Visibility="Collapsed"
                                                     Fill="Transparent"
                                                     Stroke="#FFFFE600"
                                                     StrokeThickness="2" />
                                            <Line x:Name="PreviewLine"
                                                  Visibility="Collapsed"
                                                  Stroke="#FFFFE600"
                                                  StrokeThickness="2.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <Polyline x:Name="PreviewInk"
                                                      Visibility="Collapsed"
                                                      Stroke="#FFFFE600"
                                                      StrokeThickness="3"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Floating Top-Right Find Dialogue (Collapsed by default, opens only on Ctrl+F / Search click) -->
                    <Border x:Name="FloatingSearchBorder"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,14,26,0"
                            Padding="10,8"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            Visibility="{Binding IsSearchBarVisible, Converter={StaticResource BoolToVis}}"
                            IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.32" Color="Black" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding SelectedTab}">
                            <ui:TextBox x:Name="FloatingSearchBox"
                                        Width="220"
                                        PlaceholderText="Find in document..."
                                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        KeyDown="FloatingSearchBox_KeyDown" />

                            <ToggleButton IsChecked="{Binding CaseSensitiveSearch}"
                                          Content="Aa"
                                          FontWeight="SemiBold"
                                          FontSize="12"
                                          Padding="8,5"
                                          Margin="6,0,0,0"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          ToolTip="Match Case" />

                            <TextBlock Text="{Binding SearchSummary}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="10,0"
                                       MinWidth="64"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />

                            <ui:Button Appearance="Transparent"
                                       Padding="6"
                                       ToolTip="Previous Match"
                                       Command="{Binding PreviousSearchMatchCommand}">
                                <ui:SymbolIcon Symbol="ChevronUp24" FontSize="15" />
                            </ui:Button>

                            <ui:Button Appearance="Transparent"
                                       Padding="6"
                                       ToolTip="Next Match"
                                       Command="{Binding NextSearchMatchCommand}">
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="15" />
                            </ui:Button>

                            <ui:Button Appearance="Transparent"
                                       Padding="6"
                                       Margin="2,0,0,0"
                                       ToolTip="Close Search (Esc)"
                                       Click="CloseSearchBar_Click">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Floating Exit Fullscreen Pill -->
                    <ui:Button HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,14,26,0"
                               Appearance="Secondary"
                               ToolTip="Exit Fullscreen (F11 or Esc)"
                               Visibility="{Binding IsFullScreen, Converter={StaticResource BoolToVis}}"
                               Command="{Binding ToggleFullScreenCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FullScreenMinimize24" FontSize="16" />
                            <TextBlock Text="Exit Fullscreen" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Floating Circle to Search with AI Card -->
                    <Border x:Name="CircleToSearchCard"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,32"
                            Padding="16,14"
                            CornerRadius="14"
                            BorderThickness="1.5"
                            BorderBrush="#FF38BDF8"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            MaxWidth="660"
                            IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" Color="#38BDF8" />
                        </Border.Effect>

                        <StackPanel>
                            <!-- Top Header -->
                            <DockPanel Margin="0,0,0,10">
                                <ui:Button DockPanel.Dock="Right"
                                           Appearance="Transparent"
                                           Padding="4"
                                           ToolTip="Close Circle to Search"
                                           Click="CloseCircleToSearch_Click">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                </ui:Button>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#2538BDF8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="BotSparkle24" FontSize="14" Foreground="#FF38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Circle to Search with AI" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="CircleToSearchPageBadge" Text=" • Page 1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Snippet of Circled Content -->
                            <Border Padding="10,8"
                                    CornerRadius="8"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Margin="0,0,0,10"
                                    MaxHeight="70">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              PanningMode="VerticalOnly"
                                              PanningDeceleration="0.001"
                                              PanningRatio="1.0"
                                              IsManipulationEnabled="True">
                                    <TextBlock x:Name="CircleToSearchSnippetText"
                                               Text="Selected region on page"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </ScrollViewer>
                            </Border>

                            <!-- Quick Action Buttons -->
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:Button Appearance="Primary"
                                           Padding="10,6"
                                           Margin="0,0,6,6"
                                           Click="CircleAction_Explain_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="BotSparkle24" FontSize="13" Margin="0,0,5,0" />
                                        <TextBlock Text="Explain Selection" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="Secondary"
                                           Padding="10,6"
                                           Margin="0,0,6,6"
                                           Click="CircleAction_Solve_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="HatGraduation24" FontSize="13" Margin="0,0,5,0" />
                                        <TextBlock Text="Solve Step-by-Step" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="Secondary"
                                           Padding="10,6"
                                           Margin="0,0,6,6"
                                           Click="CircleAction_WebSearch_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Search24" FontSize="13" Margin="0,0,5,0" />
                                        <TextBlock Text="Web Search &amp; Grounding" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="Secondary"
                                           Padding="10,6"
                                           Margin="0,0,6,6"
                                           Click="CircleAction_Practice_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="13" Margin="0,0,5,0" />
                                        <TextBlock Text="Generate Practice Questions" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="Transparent"
                                           Padding="8,6"
                                           Margin="0,0,6,6"
                                           Click="CircleAction_Copy_Click"
                                           ToolTip="Copy extracted text to clipboard">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,4,0" />
                                        <TextBlock Text="Copy Text" FontSize="11.5" />
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>

                            <!-- Custom Prompt Input -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox x:Name="CircleToSearchCustomPromptBox"
                                            Grid.Column="0"
                                            PlaceholderText="Ask AI anything about this selection (or press Enter)..."
                                            KeyDown="CircleToSearchCustomPromptBox_KeyDown"
                                            ClearButtonEnabled="True"
                                            Height="34" />

                                <ui:Button Grid.Column="1"
                                           Appearance="Primary"
                                           Padding="14,0"
                                           Height="34"
                                           Margin="8,0,0,0"
                                           Click="CircleAction_CustomAsk_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Send24" FontSize="14" Margin="0,0,4,0" />
                                        <TextBlock Text="Ask AI" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Document Properties Modal Card Overlay -->
                    <Grid Background="#80000000"
                          Visibility="{Binding IsPropertiesOpen, Converter={StaticResource BoolToVis}}"
                          IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Border MaxWidth="480"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="12"
                                Padding="24"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                DataContext="{Binding SelectedTab}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <ui:Button DockPanel.Dock="Right"
                                               Appearance="Transparent"
                                               Padding="6"
                                               Command="{Binding DataContext.TogglePropertiesCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" />
                                    </ui:Button>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Info24" FontSize="20" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Document Properties" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="File Name" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DocumentInfo.FileName}" FontWeight="Medium" TextWrapping="Wrap" Margin="0,5" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Title" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DocumentInfo.Title}" TextWrapping="Wrap" Margin="0,5" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Author" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DocumentInfo.Author}" TextWrapping="Wrap" Margin="0,5" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Pages" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DocumentInfo.PageCount}" Margin="0,5" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="File Size" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FileSizeDisplay}" Margin="0,5" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="PDF Version" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DocumentInfo.PdfVersion}" Margin="0,5" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Creator" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DocumentInfo.Creator}" TextWrapping="Wrap" Margin="0,5" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Location" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DocumentInfo.FilePath}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,5" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 5C. NOTE-TAKING STUDIO WORKSPACE -->
            <Grid x:Name="NotesStudioRoot"
                  Visibility="{Binding ShowNotesStudio, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                  IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid DataContext="{Binding Notes}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <!-- Left Notebooks Sidebar -->
                <Border Grid.Column="0"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <ui:Button DockPanel.Dock="Right"
                                       Appearance="Primary"
                                       Padding="10,6"
                                       ToolTip="Create New Note"
                                       Command="{Binding CreateNewNoteCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="NotebookAdd24" FontSize="15" Margin="0,0,5,0" />
                                    <TextBlock Text="New" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>
                            <TextBlock Text="Notebooks" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <ui:TextBox Grid.Row="1"
                                    PlaceholderText="Search notes..."
                                    Text="{Binding NotesSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,10" />

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding FilteredNotes}"
                                 SelectedItem="{Binding SelectedNote}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.PanningMode="VerticalOnly"
                                 ScrollViewer.PanningDeceleration="0.001"
                                 ScrollViewer.PanningRatio="1.0"
                                 IsManipulationEnabled="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:StudyNoteEntry}">
                                    <Border Padding="10,9"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Right"
                                                       Appearance="Transparent"
                                                       Padding="4"
                                                       ToolTip="Delete Note"
                                                       Command="{Binding DataContext.Notes.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                            </ui:Button>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PreviewText}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,3" />
                                                <TextBlock Text="{Binding UpdatedDisplay}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Right Note Editor & Rich Tools -->
                <Grid Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Note Title & Quick Actions -->
                    <Border Grid.Row="0"
                            Padding="18,12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NoteStatusText}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <ui:Button Appearance="Secondary"
                                           Padding="10,6"
                                           Click="SaveNoteButton_Click"
                                           ToolTip="Save Note (Ctrl+S)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" FontSize="15" Margin="0,0,5,0" />
                                        <TextBlock Text="Save" FontSize="12" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <ui:TextBox x:Name="NoteTitleBox"
                                        Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        PlaceholderText="Note title..."
                                        LostFocus="NoteTitleBox_LostFocus" />
                        </DockPanel>
                    </Border>

                    <!-- Rich Formatting, Handwriting Fonts, Equations, Charts & Picture Toolbar -->
                    <Border Grid.Row="1"
                            Padding="14,7"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Handwriting & Study Fonts Dropdown -->
                            <ComboBox x:Name="NoteFontBox"
                                      Width="205"
                                      ItemsSource="{x:Static vm:NotesViewModel.FontOptions}"
                                      SelectedItem="{Binding SelectedFont}"
                                      SelectionChanged="NoteFontBox_SelectionChanged"
                                      ToolTip="Choose Handwriting or Study Font"
                                      Margin="0,0,6,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NoteFontOption}">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontFamily="{Binding FontFamilyName}"
                                                   FontSize="13.5" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox x:Name="NoteFontSizeBox"
                                      Width="66"
                                      ItemsSource="{x:Static vm:NotesViewModel.FontSizeOptions}"
                                      SelectedItem="{Binding SelectedFontSize}"
                                      SelectionChanged="NoteFontSizeBox_SelectionChanged"
                                      ToolTip="Font Size"
                                      Margin="0,0,8,0" />

                            <!-- Text Formatting -->
                            <ui:Button Appearance="Transparent" Padding="7,5" ToolTip="Bold" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=NoteRichEditor}">
                                <ui:SymbolIcon Symbol="TextBold24" FontSize="15" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Padding="7,5" ToolTip="Italic" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=NoteRichEditor}">
                                <ui:SymbolIcon Symbol="TextItalic24" FontSize="15" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Padding="7,5" ToolTip="Underline" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=NoteRichEditor}">
                                <ui:SymbolIcon Symbol="TextUnderline24" FontSize="15" />
                            </ui:Button>

                            <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                            <ui:Button Appearance="Transparent" Padding="7,5" ToolTip="Bulleted List" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=NoteRichEditor}">
                                <ui:SymbolIcon Symbol="TextBulletList24" FontSize="15" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Padding="7,5" ToolTip="Numbered List" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=NoteRichEditor}">
                                <ui:SymbolIcon Symbol="TextNumberListLtr24" FontSize="15" />
                            </ui:Button>

                            <ui:Button Appearance="Transparent" Padding="7,5" ToolTip="Align Left" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=NoteRichEditor}">
                                <ui:SymbolIcon Symbol="TextAlignLeft24" FontSize="15" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Padding="7,5" ToolTip="Align Center" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=NoteRichEditor}">
                                <ui:SymbolIcon Symbol="TextAlignCenter24" FontSize="15" />
                            </ui:Button>
                            <ui:Button Appearance="Transparent" Padding="7,5" ToolTip="Align Right" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=NoteRichEditor}">
                                <ui:SymbolIcon Symbol="TextAlignRight24" FontSize="15" />
                            </ui:Button>

                            <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                            <!-- Text Color Swatches -->
                            <ItemsControl ItemsSource="{x:Static vm:NotesViewModel.NoteColorSwatches}" VerticalAlignment="Center" Margin="0,0,6,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Apply Text Color"
                                                Tag="{Binding}"
                                                Click="NoteTextColor_Click">
                                            <Ellipse Width="14" Height="14" Fill="{Binding Converter={StaticResource HexToBrush}}" Stroke="#66808080" StrokeThickness="1" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Width="1" Height="20" Margin="6,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                            <!-- Rich Study Insert Tools: Pictures, Math Equations, Charts/Graphs, Handwriting Sketch Pad -->
                            <ui:Button Appearance="Secondary" Padding="10,5" Margin="0,0,5,0" Click="InsertPictureInNote_Click" ToolTip="Insert Picture (PNG, JPG, BMP)">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ImageAdd24" FontSize="15" Margin="0,0,5,0" />
                                    <TextBlock Text="Picture" FontSize="12" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Appearance="Secondary" Padding="10,5" Margin="0,0,5,0" Click="InsertEquationInNote_Click" ToolTip="Build &amp; Insert Mathematical Equation">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="MathFormula24" FontSize="15" Margin="0,0,5,0" />
                                    <TextBlock Text="Equation" FontSize="12" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Appearance="Secondary" Padding="10,5" Margin="0,0,5,0" Click="InsertChartInNote_Click" ToolTip="Create &amp; Insert Bar/Line/Pie/Scatter Chart or Function Graph">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="15" Margin="0,0,5,0" />
                                    <TextBlock Text="Chart / Graph" FontSize="12" />
                                </StackPanel>
                            </ui:Button>

                            <ToggleButton IsChecked="{Binding IsSketchPadOpen}"
                                          Padding="10,5"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                          Background="{DynamicResource ControlFillColorDefaultBrush}"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          ToolTip="Toggle Handwriting &amp; Diagram Sketch Pad">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="InkingTool24" FontSize="15" Margin="0,0,5,0" />
                                    <TextBlock Text="Sketch Pad" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                        </WrapPanel>
                    </Border>

                    <!-- Rich Note Document Editor -->
                    <Border Grid.Row="2"
                            Margin="22,16"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <RichTextBox x:Name="NoteRichEditor"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     BorderThickness="0"
                                     Padding="24,20"
                                     FontSize="15"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.PanningMode="VerticalOnly"
                                     ScrollViewer.PanningDeceleration="0.001"
                                     ScrollViewer.PanningRatio="1.0"
                                     IsManipulationEnabled="True"
                                     TextChanged="NoteRichEditor_TextChanged" />
                    </Border>

                    <!-- Built-In Handwriting & Diagram Sketch Pad (when toggled open) -->
                    <Border Grid.Row="3"
                            Height="230"
                            Margin="22,0,22,16"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{Binding IsSketchPadOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="12,6"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:Button Appearance="Secondary" Padding="10,4" Margin="0,0,6,0" Click="ClearSketchPad_Click">
                                            <TextBlock Text="Clear" FontSize="11.5" />
                                        </ui:Button>
                                        <ui:Button Appearance="Primary" Padding="12,4" Click="InsertSketchIntoNote_Click">
                                            <TextBlock Text="Insert Sketch into Note" FontSize="11.5" FontWeight="SemiBold" />
                                        </ui:Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Handwriting &amp; Sketch Pad" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{x:Static vm:NotesViewModel.NoteColorSwatches}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Padding="2" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.Notes.SetSketchColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Ellipse Width="14" Height="14" Fill="{Binding Converter={StaticResource HexToBrush}}" Stroke="#66808080" StrokeThickness="1" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ToggleButton IsChecked="{Binding IsSketchHighlighter}" Padding="8,3" Margin="0,0,6,0"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                      Click="SketchToolOption_Click">
                                            <TextBlock Text="Highlighter" FontSize="11.5" />
                                        </ToggleButton>
                                        <ToggleButton IsChecked="{Binding IsSketchEraser}" Padding="8,3"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                      Click="SketchToolOption_Click">
                                            <TextBlock Text="Eraser" FontSize="11.5" />
                                        </ToggleButton>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <InkCanvas x:Name="NoteSketchCanvas"
                                       Grid.Row="1"
                                       Background="#FFFAFAFC" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- NEWS & CURRENT AFFAIRS FEED (Daily, Weekly, Monthly) -->
            <Grid x:Name="NewsFeedRoot"
                  Visibility="{Binding ShowNewsFeed, Converter={StaticResource BoolToVis}}"
                  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                  IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>

                <Grid DataContext="{Binding NewsFeed}">
                    <!-- 1. FEED BROWSING VIEW (Active when Reader is closed) -->
                    <Grid Visibility="{Binding IsReaderOpen, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <!-- Feed Top Bar: Daily / Weekly / Monthly + Search + Refresh -->
                    <Border Grid.Row="0"
                            Padding="24,16,24,12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBox PlaceholderText="Filter headlines..."
                                            Width="220"
                                            Margin="0,0,8,0"
                                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Appearance="Secondary"
                                           Padding="12,7"
                                           Command="{Binding RefreshFeedCommand}"
                                           ToolTip="Refresh Latest Stories">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Refresh" FontSize="12" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="News24" FontSize="22" Foreground="#FF38BDF8" Margin="0,0,10,0" />
                                    <TextBlock Text="Study &amp; Current Affairs Feed" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />

                                    <!-- Daily / Weekly / Monthly Toggle Pills -->
                                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <StackPanel.Resources>
                                            <Style x:Key="FeedTimeframePillStyle" TargetType="ToggleButton">
                                                <Setter Property="Margin" Value="0,0,6,0" />
                                                <Setter Property="Padding" Value="12,5" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="PillBorder"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                    BorderThickness="1"
                                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </StackPanel.Resources>
                                        <ToggleButton Style="{StaticResource FeedTimeframePillStyle}"
                                                      IsChecked="{Binding IsDailySelected, Mode=OneWay}"
                                                      Command="{Binding SelectTimeframeCommand}"
                                                      CommandParameter="{x:Static models:NewsTimeframe.Daily}"
                                                      Content="Daily News" />
                                        <ToggleButton Style="{StaticResource FeedTimeframePillStyle}"
                                                      IsChecked="{Binding IsWeeklySelected, Mode=OneWay}"
                                                      Command="{Binding SelectTimeframeCommand}"
                                                      CommandParameter="{x:Static models:NewsTimeframe.Weekly}"
                                                      Content="Weekly News" />
                                        <ToggleButton Style="{StaticResource FeedTimeframePillStyle}"
                                                      IsChecked="{Binding IsMonthlySelected, Mode=OneWay}"
                                                      Command="{Binding SelectTimeframeCommand}"
                                                      CommandParameter="{x:Static models:NewsTimeframe.Monthly}"
                                                      Content="Monthly News" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="32,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Category Chips + Loading Bar -->
                    <Border Grid.Row="1"
                            Padding="24,8"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Topic:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{x:Static models:NewsFeedCatalog.Categories}"
                                          SelectedValuePath="Category"
                                          SelectedValue="{Binding SelectedCategory, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          MinWidth="190"
                                          HorizontalAlignment="Left" />
                            </DockPanel>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Feed Cards List -->
                    <ScrollViewer x:Name="NewsFeedScrollViewer"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  PanningMode="VerticalOnly"
                                  PanningDeceleration="0.001"
                                  PanningRatio="1.0"
                                  IsManipulationEnabled="True"
                                  PreviewMouseWheel="NewsFeedScrollViewer_PreviewMouseWheel"
                                  Padding="24,14">
                        <Grid MaxWidth="1020">
                            <ItemsControl ItemsSource="{Binding FilteredItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:NewsFeedItem}">
                                        <Border Padding="14"
                                                Margin="0,0,0,12"
                                                CornerRadius="10"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Lead Thumbnail Column -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Details & Controls Column -->
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Lead Thumbnail Image (Clickable) -->
                                                <Border Grid.Column="0"
                                                        Width="180"
                                                        Height="116"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Top"
                                                        Cursor="Hand"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.NewsFeed.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <ui:SymbolIcon Symbol="News24"
                                                                       FontSize="32"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        <Image Source="{Binding ImageUrl}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                </Border>

                                                <!-- Article Details & Actions -->
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <!-- Read in App (Primary CTA) -->
                                                            <ui:Button Appearance="Primary"
                                                                       Padding="10,4"
                                                                       Margin="0,0,6,0"
                                                                       ToolTip="Read full article inside StudySuit"
                                                                       Command="{Binding DataContext.NewsFeed.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="13.5" Margin="0,0,5,0" />
                                                                    <TextBlock Text="Read" FontSize="11.5" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </ui:Button>

                                                            <!-- Read Aloud (Hindi Voice) -->
                                                            <ui:Button Appearance="Transparent"
                                                                       Padding="7,4"
                                                                       Margin="0,0,4,0"
                                                                       ToolTip="Read Article Aloud (Hindi / Voice)"
                                                                       Command="{Binding DataContext.NewsFeed.ReadArticleAloudCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}"
                                                                       Visibility="{Binding IsSpeaking, Converter={StaticResource InverseBoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="14" Foreground="#FF38BDF8" Margin="0,0,4,0" />
                                                                    <TextBlock Text="Listen" FontSize="11.5" />
                                                                </StackPanel>
                                                            </ui:Button>

                                                            <ui:Button Appearance="Transparent"
                                                                       Padding="7,4"
                                                                       Margin="0,0,4,0"
                                                                       ToolTip="Stop Reading"
                                                                       Command="{Binding DataContext.NewsFeed.StopArticleReadoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="Stop24" FontSize="14" Foreground="#FFF87171" Margin="0,0,4,0" />
                                                                    <TextBlock Text="Stop" FontSize="11.5" Foreground="#FFF87171" />
                                                                </StackPanel>
                                                            </ui:Button>

                                                            <!-- Ask AI -->
                                                            <ui:Button Appearance="Secondary"
                                                                       Padding="8,4"
                                                                       Margin="0,0,4,0"
                                                                       ToolTip="Analyze this story with AI Study Assistant"
                                                                       Command="{Binding DataContext.NewsFeed.DiscussWithAiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="BotSparkle24" FontSize="13.5" Margin="0,0,4,0" />
                                                                    <TextBlock Text="Ask AI" FontSize="11.5" />
                                                                </StackPanel>
                                                            </ui:Button>

                                                            <!-- Open in External Browser -->
                                                            <ui:Button Appearance="Transparent"
                                                                       Padding="6,4"
                                                                       ToolTip="Open in external browser"
                                                                       Tag="{Binding Url}"
                                                                       Click="OpenWebSourceUrl_Click">
                                                                <ui:SymbolIcon Symbol="Open24" FontSize="13" />
                                                            </ui:Button>
                                                        </StackPanel>

                                                        <!-- Badges: Source, Category, Published -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Padding="7,2" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Source}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding PublishedDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- Clickable Title -->
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Cursor="Hand"
                                                               Margin="0,0,0,4">
                                                        <TextBlock.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.NewsFeed.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}" />
                                                        </TextBlock.InputBindings>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding Summary}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="44"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Padding="24"
                                    CornerRadius="10"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,24,0,0"
                                    Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="No stories loaded yet. Click Refresh or switch Daily / Weekly / Monthly."
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 2. IN-APP ARTICLE READER VIEW (Active when an article is open) -->
                <Grid Visibility="{Binding IsReaderOpen, Converter={StaticResource BoolToVis}}"
                      Background="{DynamicResource ApplicationBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Reader Top Navigation Bar -->
                    <Border Grid.Row="0"
                            Padding="24,12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <DockPanel>
                            <!-- Left: Back Button & Badges -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary"
                                           Padding="12,6"
                                           Margin="0,0,14,0"
                                           Command="{Binding CloseReaderCommand}"
                                           ToolTip="Return to News Feed List">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Back to Feed" FontWeight="SemiBold" FontSize="12.5" />
                                    </StackPanel>
                                </ui:Button>

                                <Border Padding="8,3" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedArticle.Source}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <Border Padding="8,3" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedArticle.CategoryLabel}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <TextBlock Text="{Binding SelectedArticle.PublishedDisplay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right: Audio & AI Controls -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <!-- Listen Aloud Button -->
                                <ui:Button Appearance="Primary"
                                           Padding="12,6"
                                           Margin="0,0,8,0"
                                           ToolTip="Read article aloud with Hindi / configured voice"
                                           Command="{Binding ReadActiveArticleAloudCommand}"
                                           Visibility="{Binding IsActiveArticleSpeaking, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Speaker224" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Listen Aloud (Hindi Voice)" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </ui:Button>

                                <!-- Stop Reading Button -->
                                <ui:Button Appearance="Danger"
                                           Padding="12,6"
                                           Margin="0,0,8,0"
                                           ToolTip="Stop voice readout"
                                           Command="{Binding StopArticleReadoutCommand}"
                                           Visibility="{Binding IsActiveArticleSpeaking, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Stop24" FontSize="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Stop Audio" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </ui:Button>

                                <!-- Discuss with AI Button -->
                                <ui:Button Appearance="Secondary"
                                           Padding="12,6"
                                           Margin="0,0,8,0"
                                           ToolTip="Analyze this article in AI Study Assistant"
                                           Command="{Binding DiscussActiveArticleWithAiCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="BotSparkle24" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Ask AI" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </ui:Button>

                                <!-- Open in Browser fallback -->
                                <ui:Button Appearance="Transparent"
                                           Padding="8,6"
                                           ToolTip="Open original article in external browser"
                                           Tag="{Binding SelectedArticle.Url}"
                                           Click="OpenWebSourceUrl_Click">
                                    <ui:SymbolIcon Symbol="Open24" FontSize="15" />
                                </ui:Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Scrollable In-App Reader Canvas -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  PanningMode="VerticalOnly"
                                  PanningDeceleration="0.001"
                                  PanningRatio="1.0"
                                  IsManipulationEnabled="True"
                                  Padding="32,24,32,48">
                        <StackPanel MaxWidth="840" HorizontalAlignment="Center">
                            <!-- Article Headline -->
                            <TextBlock Text="{Binding SelectedArticle.Title}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       LineHeight="33"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16" />

                            <!-- Byline info -->
                            <Border Padding="0,0,0,16" Margin="0,0,0,20" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="Published by " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" />
                                        <TextBlock Text="{Binding SelectedArticle.Source}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,8,0" />
                                        <TextBlock Text="• " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" />
                                        <TextBlock Text="{Binding SelectedArticle.PublishedDisplay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="StudySuit In-App Reader" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </DockPanel>
                            </Border>

                            <!-- Hero Image -->
                            <Border CornerRadius="12"
                                    ClipToBounds="True"
                                    Margin="0,0,0,24"
                                    MaxHeight="420"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{Binding SelectedArticle.HasImage, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding SelectedArticle.ImageUrl}"
                                       Stretch="UniformToFill"
                                       MaxHeight="420"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <!-- Loading Spinner when fetching full article text -->
                            <Border Padding="16"
                                    Margin="0,0,0,16"
                                    CornerRadius="8"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{Binding IsLoadingArticleContent, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" />
                                    <TextBlock Text="Extracting full article text from source..." VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Article Content Text -->
                            <TextBlock Text="{Binding ActiveArticleContent}"
                                       FontSize="15"
                                       LineHeight="26"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Margin="0,0,0,32" />

                            <!-- Study & Exam Preparation Insights Box -->
                            <Border Padding="20,18"
                                    CornerRadius="12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Margin="0,12,0,24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Foreground="#FF38BDF8" Margin="0,0,8,0" />
                                        <TextBlock Text="StudySuit AI • Instant Study &amp; Exam Insights" FontWeight="SemiBold" FontSize="14" />
                                    </StackPanel>
                                    <TextBlock Text="Turn this story into exam preparation notes, conceptual breakdowns, or test practice questions."
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,14" />

                                    <WrapPanel>
                                        <ui:Button Appearance="Secondary"
                                                   Padding="12,7"
                                                   Margin="0,0,10,8"
                                                   Command="{Binding QuickAiAnalysisCommand}"
                                                   CommandParameter="Summarize Key Takeaways">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Key Takeaways Summary" FontSize="12" />
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button Appearance="Secondary"
                                                   Padding="12,7"
                                                   Margin="0,0,10,8"
                                                   Command="{Binding QuickAiAnalysisCommand}"
                                                   CommandParameter="Explain Exam Relevance">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="HatGraduation24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Exam Relevance (UPSC / SSC)" FontSize="12" />
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button Appearance="Secondary"
                                                   Padding="12,7"
                                                   Margin="0,0,10,8"
                                                   Command="{Binding QuickAiAnalysisCommand}"
                                                   CommandParameter="Generate 3 Practice Questions">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="BotSparkle24" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Generate 3 Practice Questions" FontSize="12" />
                                            </StackPanel>
                                        </ui:Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Bottom Return Button -->
                            <ui:Button Appearance="Secondary"
                                       Padding="14,8"
                                       HorizontalAlignment="Center"
                                       Command="{Binding CloseReaderCommand}"
                                       Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Return to News Feed List" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- NCERT TEXTBOOKS LIBRARY (Class 6 to 12 • 1-Click Download & Read) -->
        <Grid x:Name="NcertLibraryRoot"
              Visibility="{Binding ShowNcertLibrary, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>

            <Grid DataContext="{Binding Library}">
                <Grid.RowDefinitions>
                <!-- Row 0: Top Header & Stats -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Filters Bar (Search, Class, Subject, Only Downloaded) -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Books Catalog Grid -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header -->
            <Border Grid.Row="0"
                    Padding="28,18,28,14"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <DockPanel>
                    <!-- Right: Summary badge & Open Folder button -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Border Padding="12,6"
                                CornerRadius="8"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="#FF4ADE80" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SummaryText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ui:Button Appearance="Secondary"
                                   Padding="12,6"
                                   Command="{Binding OpenLibraryFolderCommand}"
                                   ToolTip="Open local NCERT storage folder in Windows Explorer">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Open Folder" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <!-- Left: Title & Subtitle -->
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#258B5CF6" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Library24" FontSize="17" Foreground="#FFA78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="NCERT Textbooks Library" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4" Background="#180078D4" VerticalAlignment="Center">
                                <TextBlock Text="Classes 6–12 • Direct In-App Downloads" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Official NCERT textbooks downloaded directly inside StudySuit — open any book or chapter with AI study partner &amp; voice readout."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 1: Filters Bar (Search, Class, Subject, Only Downloaded) -->
            <Border Grid.Row="1"
                    Padding="28,10,28,10"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <ui:TextBox Width="260"
                                PlaceholderText="Search books, subjects, topics..."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                ClearButtonEnabled="True"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" FontSize="13" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Class Filter Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Class:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ClassOptions}"
                                  SelectedItem="{Binding SelectedClassOption}"
                                  Width="130"
                                  Height="32"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Subject Filter Dropdown -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Subject:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding SubjectFilters}"
                                  SelectedItem="{Binding SelectedSubject}"
                                  Width="150"
                                  Height="32"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Only Downloaded Checkbox -->
                    <CheckBox IsChecked="{Binding OnlyDownloaded}"
                              Content="Downloaded Only"
                              FontSize="12"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0" />

                    <!-- Reset Filter Button -->
                    <ui:Button Appearance="Transparent"
                               Padding="8,4"
                               VerticalAlignment="Center"
                               Command="{Binding SelectSubjectCommand}"
                               CommandParameter="All"
                               ToolTip="Reset all filters">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Reset Filters" FontSize="11.5" />
                        </StackPanel>
                    </ui:Button>
                </WrapPanel>
            </Border>

            <!-- Row 2: Books Catalog Grid -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          PanningDeceleration="0.001"
                          PanningRatio="1.0"
                          IsManipulationEnabled="True"
                          Padding="24,18">
                <StackPanel>
                    <!-- Global Status / Notification Banner -->
                    <Border Visibility="{Binding GlobalStatusMessage, Converter={StaticResource NullToVis}}"
                            Background="#1A3B82F6"
                            BorderBrush="#403B82F6"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,8"
                            Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="#FF60A5FA" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GlobalStatusMessage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Books Cards List -->
                    <ItemsControl ItemsSource="{Binding FilteredBooks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NcertBookItem}">
                                <Border Width="370"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,0,16,16"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12"
                                                          ShadowDepth="2"
                                                          Direction="270"
                                                          Opacity="0.12"
                                                          Color="Black" />
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Top Badges & Subject Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Right"
                                                    Padding="8,3"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding StatusBadgeText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Padding="8,3"
                                                        CornerRadius="6"
                                                        Background="#253B82F6"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding ClassDisplay}"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>

                                                <Border Padding="8,3"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Subject}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Border>

                                                <TextBlock Text="{Binding EstimatedSizeDisplay}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Row 1: Book Title & Description -->
                                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="36"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Row 2: Download Progress Bar (When downloading) -->
                                        <StackPanel Grid.Row="2"
                                                    Margin="0,0,0,10"
                                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar Value="{Binding DownloadProgressPercent}"
                                                         Maximum="100"
                                                         Height="6"
                                                         Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding DownloadStatusText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <!-- Row 3: Action Buttons -->
                                        <DockPanel Grid.Row="3">
                                            <!-- Right: Chapters Drawer toggle & Delete Button -->
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <!-- Chapters toggle -->
                                                <ui:Button Appearance="Secondary"
                                                           Padding="10,5"
                                                           Margin="0,0,6,0"
                                                           Command="{Binding DataContext.ToggleChaptersCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding HasMultipleChapters, Converter={StaticResource BoolToVis}}"
                                                           ToolTip="View individual chapter PDFs">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Chapters" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ui:Button>

                                                <!-- Delete button (visible when downloaded) -->
                                                <ui:Button Appearance="Transparent"
                                                           Padding="6,5"
                                                           Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}"
                                                           ToolTip="Delete downloaded book to free up disk space">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#FFF87171" />
                                                </ui:Button>
                                            </StackPanel>

                                            <!-- Left: Download Button (when not downloaded) -->
                                            <ui:Button Appearance="Primary"
                                                       Padding="14,6"
                                                       Command="{Binding DataContext.DownloadBookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding IsDownloaded, Converter={StaticResource InverseBoolToVis}}"
                                                       IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBoolToVis}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Download Book" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ui:Button>

                                            <!-- Left: Open in Reader Button (when downloaded) -->
                                            <ui:Button Appearance="Primary"
                                                       Padding="14,6"
                                                       Command="{Binding DataContext.OpenBookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="BookOpen24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Open Book in Reader" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ui:Button>
                                        </DockPanel>

                                        <!-- Row 4: Expandable Chapters Drawer -->
                                        <Border Grid.Row="4"
                                                Margin="0,12,0,0"
                                                Padding="10"
                                                CornerRadius="8"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                Visibility="{Binding AreChaptersExpanded, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Select a chapter to open directly in reader:"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Chapters}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:NcertChapterItem}">
                                                            <ui:Button Appearance="Transparent"
                                                                       HorizontalAlignment="Stretch"
                                                                       HorizontalContentAlignment="Left"
                                                                       Padding="8,4"
                                                                       Margin="0,0,0,2"
                                                                       Command="{Binding DataContext.Library.OpenChapterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding}">
                                                                <DockPanel LastChildFill="True">
                                                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="11" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="13" Foreground="#FFEF4444" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding DisplayText}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </ui:Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty Results State -->
                    <Border Padding="32"
                            CornerRadius="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,32,0,0"
                            Visibility="{Binding HasNoMatchingBooks, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="SearchVisual24" FontSize="36" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="No textbooks matched your filters"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Try clearing your search text or switching to All Classes / All Subjects."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>

            <!-- Loading Overlay -->
            <Grid Background="#70000000"
                  Visibility="{Binding IsOpeningDocument, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" />
                    <TextBlock Text="Opening PDF..." FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
            </Grid>

            <!-- Right Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding ShowAiSidebar, Converter={StaticResource BoolToVis}}" />

            <!-- RIGHT COLLAPSIBLE AI ASSISTANT SIDEBAR -->
            <Border x:Name="AiSidebarBorder"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    MinWidth="300"
                    MaxWidth="780"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Visibility="{Binding ShowAiSidebar, Converter={StaticResource BoolToVis}}"
                    IsVisibleChanged="AnimatedSurface_IsVisibleChanged">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>

                <Grid DataContext="{Binding AiAssistant}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- AI Header -->
                    <Border Grid.Row="0"
                            Padding="14,10"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Transparent"
                                           Padding="6"
                                           ToolTip="New Chat (+)"
                                           Command="{Binding NewChatCommand}">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent"
                                           Padding="6"
                                           ToolTip="All Chat History"
                                           Command="{Binding ToggleHistoryCommand}">
                                    <ui:SymbolIcon Symbol="History24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent"
                                           Padding="6"
                                           ToolTip="AI Model &amp; Internet Settings"
                                           Command="{Binding OpenSettingsCommand}">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent"
                                           Padding="6"
                                           ToolTip="Clear Conversation"
                                           Command="{Binding ClearChatCommand}">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent"
                                           Padding="6"
                                           ToolTip="Close AI Sidebar"
                                           Command="{Binding DataContext.ToggleAiSidebarCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                </ui:Button>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="BotSparkle24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="AI Study Assistant" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveProviderLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="26,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Quick Study Prompt Chips -->
                    <Border Grid.Row="1"
                            Padding="10,7"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <WrapPanel Orientation="Horizontal">
                            <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,5,4"
                                       Command="{Binding SendQuickPromptCommand}"
                                       CommandParameter="Summarize this page clearly with key bullet points.">
                                <TextBlock Text="Summarize Page" FontSize="11" />
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,5,4"
                                       Command="{Binding SendQuickPromptCommand}"
                                       CommandParameter="Explain the concepts on this page in simple terms with an intuitive example.">
                                <TextBlock Text="Explain Simply" FontSize="11" />
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,5,4"
                                       Command="{Binding SendQuickPromptCommand}"
                                       CommandParameter="Create 3 short practice quiz questions with answers based on this page.">
                                <TextBlock Text="Quiz Me" FontSize="11" />
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,0,4"
                                       Command="{Binding SendQuickPromptCommand}"
                                       CommandParameter="Extract the key definitions, formulas, and takeaways from this page.">
                                <TextBlock Text="Key Takeaways" FontSize="11" />
                            </ui:Button>
                        </WrapPanel>
                    </Border>

                    <!-- Row 2: Chat Messages Feed & Watermark Placeholder -->
                    <Grid Grid.Row="2">
                        <!-- Clean Empty State Watermark Placeholder (shown when chat has 0 messages) -->
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="24"
                                Margin="16"
                                Visibility="{Binding HasNoMessages, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="48" Height="48"
                                        CornerRadius="24"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,12">
                                    <ui:SymbolIcon Symbol="BotSparkle24"
                                                   FontSize="24"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="StudySuit AI Assistant"
                                           FontSize="14.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="Ask questions about your PDF, extract formulas, solve problems, or use Circle to Search."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="260"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Chat Messages Feed -->
                        <ScrollViewer x:Name="AiChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      PanningMode="VerticalOnly"
                                      PanningDeceleration="0.001"
                                      PanningRatio="1.0"
                                      IsManipulationEnabled="True"
                                      PreviewMouseWheel="AiChatScrollViewer_PreviewMouseWheel"
                                      MouseWheel="AiChatScrollViewer_PreviewMouseWheel"
                                      Padding="12,10">
                        <ItemsControl x:Name="AiChatItemsControl"
                                      ItemsSource="{Binding Messages}"
                                      HorizontalContentAlignment="Stretch"
                                      SizeChanged="AiChatItemsControl_SizeChanged">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AiChatMessage}">
                                    <Grid Margin="0,0,0,10">
                                        <!-- User Message Bubble -->
                                        <Border HorizontalAlignment="Right"
                                                Margin="40,0,0,0"
                                                Padding="11,8"
                                                CornerRadius="10"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}"
                                                           Foreground="White"
                                                           FontSize="12.5"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding TimeDisplay}"
                                                           Foreground="#CCFFFFFF"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Directly Embedded AI Response (No Chat Bubble Box) -->
                                        <Border HorizontalAlignment="Stretch"
                                                Padding="2,6,2,12"
                                                Margin="0,2,0,4"
                                                Background="Transparent"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Hindi / English Voice Readout Button -->
                                                        <ui:Button Appearance="Transparent"
                                                                   Padding="5,3"
                                                                   Margin="0,0,2,0"
                                                                   ToolTip="Read Response Aloud (Hindi / Voice)"
                                                                   Command="{Binding DataContext.AiAssistant.ToggleSpeakMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"
                                                                   Visibility="{Binding IsSpeaking, Converter={StaticResource InverseBoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Speaker224" FontSize="13.5" Foreground="#FF38BDF8" Margin="0,0,4,0" />
                                                                <TextBlock Text="Read" FontSize="11" />
                                                            </StackPanel>
                                                        </ui:Button>

                                                        <ui:Button Appearance="Transparent"
                                                                   Padding="5,3"
                                                                   Margin="0,0,2,0"
                                                                   ToolTip="Stop Reading Aloud"
                                                                   Command="{Binding DataContext.AiAssistant.StopSpeakingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Stop24" FontSize="13.5" Foreground="#FFF87171" Margin="0,0,4,0" />
                                                                <TextBlock Text="Stop" FontSize="11" Foreground="#FFF87171" />
                                                            </StackPanel>
                                                        </ui:Button>

                                                        <ui:Button Appearance="Transparent"
                                                                   Padding="5,3"
                                                                   Margin="0,0,2,0"
                                                                   ToolTip="Copy Response"
                                                                   Command="{Binding DataContext.AiAssistant.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,4,0" />
                                                                <TextBlock Text="Copy" FontSize="11" />
                                                            </StackPanel>
                                                        </ui:Button>

                                                        <ui:Button Appearance="Transparent"
                                                                   Padding="5,3"
                                                                   ToolTip="Insert Response into Active Study Note"
                                                                   Command="{Binding DataContext.AiAssistant.SendToNotesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="NotebookAdd24" FontSize="13.5" />
                                                        </ui:Button>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,5,0" />
                                                        <TextBlock Text="StudySuit AI" FontSize="11.5" FontWeight="SemiBold" />
                                                        <TextBlock Text=" • PDF" FontSize="10.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   Visibility="{Binding UsedPdfContext, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text=" • Web" FontSize="10.5" Foreground="#FF38BDF8"
                                                                   Visibility="{Binding UsedWebResearch, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text=" • Time" FontSize="10.5" Foreground="#FFA78BFA"
                                                                   Visibility="{Binding UsedTimeContext, Converter={StaticResource BoolToVis}}" ToolTip="Live clock/calendar context used" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <controls:MarkdownMessageView MarkdownText="{Binding Content, Mode=OneWay}"
                                                                              IsDarkTheme="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" />

                                                <!-- Clickable Web Sources -->
                                                <StackPanel Margin="0,8,0,0" Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Sources:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding Sources}" HorizontalContentAlignment="Stretch">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:WebSourceReference}">
                                                                <Button Style="{StaticResource ThemedCardButtonStyle}"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left"
                                                                        Padding="8,5"
                                                                        Margin="0,0,0,4"
                                                                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Tag="{Binding Url}"
                                                                        Click="OpenWebSourceUrl_Click">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ui:SymbolIcon Grid.Column="0" Symbol="Link24" FontSize="12" Foreground="#FF38BDF8" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis">
                                                                            <Run Text="[" /><Run Text="{Binding Index, Mode=OneWay}" /><Run Text="] " />
                                                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>

                    <!-- Busy Progress & Status -->
                    <StackPanel Grid.Row="3" Margin="12,4,12,4">
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Prompt Input Composer -->
                    <Border Grid.Row="4"
                            Padding="12,10"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ToggleButton IsChecked="{Binding UsePdfContext}"
                                              Padding="8,4"
                                              Margin="0,0,6,4"
                                              BorderThickness="1"
                                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                              Background="Transparent"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              ToolTip="Allow the AI to read and search the open PDF when relevant">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="13" Margin="0,0,5,0" />
                                        <TextBlock Text="PDF Context" FontSize="11" />
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton IsChecked="{Binding UseWebResearch}"
                                              Padding="8,4"
                                              Margin="0,0,6,4"
                                              BorderThickness="1"
                                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                              Background="Transparent"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              ToolTip="Allow the AI to search the internet when up-to-date facts or web lookup are needed">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="GlobeSearch24" FontSize="13" Foreground="#FF38BDF8" Margin="0,0,5,0" />
                                        <TextBlock Text="Web Research" FontSize="11" />
                                    </StackPanel>
                                </ToggleButton>
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox x:Name="AiPromptBox"
                                            Grid.Column="0"
                                            PlaceholderText="Ask anything, search PDF, or research online... (Shift+Enter for new line)"
                                            Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            MaxHeight="110"
                                            MinHeight="38"
                                            FontSize="12.5"
                                            VerticalScrollBarVisibility="Auto"
                                            PreviewKeyDown="AiPromptBox_KeyDown" />

                                <ui:Button Grid.Column="1"
                                           Appearance="Primary"
                                           Margin="6,0,0,0"
                                           Padding="10,8"
                                           VerticalAlignment="Bottom"
                                           Command="{Binding SendMessageCommand}"
                                           Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                                           ToolTip="Send (Enter)">
                                    <ui:SymbolIcon Symbol="Send24" FontSize="16" />
                                </ui:Button>

                                <ui:Button Grid.Column="1"
                                           Appearance="Danger"
                                           Margin="6,0,0,0"
                                           Padding="10,8"
                                           VerticalAlignment="Bottom"
                                           Command="{Binding StopRequestCommand}"
                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                           ToolTip="Stop">
                                    <ui:SymbolIcon Symbol="Stop24" FontSize="16" />
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Chat History Drawer / Overlay (All Saved Sessions) -->
                    <Border Grid.Row="1" Grid.RowSpan="4"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVis}}"
                            Panel.ZIndex="100">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- History Toolbar -->
                            <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Primary" Padding="10,5" Margin="0,0,6,0"
                                                   Command="{Binding NewChatCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,5,0" />
                                                <TextBlock Text="New Chat" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button Appearance="Secondary" Padding="7,5"
                                                   ToolTip="Back to Active Chat"
                                                   Command="{Binding ToggleHistoryCommand}">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
                                        </ui:Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="History24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Chat History" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- History Search Filter -->
                            <Border Grid.Row="1" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <ui:TextBox PlaceholderText="Search past conversations..."
                                            Text="{Binding HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                            ClearButtonEnabled="True"
                                            FontSize="12"
                                            Padding="8,5">
                                    <ui:TextBox.Icon>
                                        <ui:SymbolIcon Symbol="Search24" FontSize="13" />
                                    </ui:TextBox.Icon>
                                </ui:TextBox>
                            </Border>

                            <!-- Sessions List -->
                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly"
                                          PanningDeceleration="0.001"
                                          PanningRatio="1.0"
                                          IsManipulationEnabled="True"
                                          Padding="10,8">
                                <StackPanel>
                                    <!-- Empty State -->
                                    <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center"
                                                Visibility="{Binding HasNoHistorySessions, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Chat24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                        <TextBlock Text="No past conversations yet" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Your study conversations will be automatically saved here." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" />
                                    </StackPanel>

                                    <!-- Session Cards -->
                                    <ItemsControl ItemsSource="{Binding FilteredSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:AiChatSession}">
                                                <Border Margin="0,0,0,6"
                                                        Padding="10,9"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <DockPanel>
                                                        <!-- Delete session button -->
                                                        <ui:Button DockPanel.Dock="Right"
                                                                   Appearance="Transparent"
                                                                   Padding="5"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="Delete from history"
                                                                   Command="{Binding DataContext.AiAssistant.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </ui:Button>

                                                        <!-- Clickable card body -->
                                                        <Button Style="{StaticResource ThemedCardButtonStyle}"
                                                                HorizontalContentAlignment="Stretch"
                                                                Command="{Binding DataContext.AiAssistant.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid Margin="0,0,6,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                        VerticalAlignment="Center" Margin="0,0,9,0">
                                                                    <ui:SymbolIcon Symbol="Chat24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding Title}" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                        <TextBlock Text="{Binding RelativeTimeDisplay}"
                                                                                   FontSize="10.5"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        <TextBlock Text=" • "
                                                                                   FontSize="10.5"
                                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                        <TextBlock Text="{Binding MessageCount, StringFormat='{}{0} messages'}"
                                                                                   FontSize="10.5"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom Actions Footer -->
                            <Border Grid.Row="3" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Left"
                                               Appearance="Transparent"
                                               Padding="6,4"
                                               ToolTip="Clear all saved history sessions"
                                               Command="{Binding ClearAllHistoryCommand}">
                                        <TextBlock Text="Clear All History" FontSize="11" Foreground="#FFF87171" />
                                    </ui:Button>

                                    <ui:Button DockPanel.Dock="Right"
                                               Appearance="Secondary"
                                               Padding="10,4"
                                               Command="{Binding ToggleHistoryCommand}">
                                        <TextBlock Text="Close" FontSize="11" />
                                    </ui:Button>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 6: Modern Status Bar -->
        <Border Grid.Row="6"
                Padding="14,5"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                Visibility="{Binding IsFullScreen, Converter={StaticResource InverseBoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GlobalStatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedTab.StatusMessage, StringFormat='  •  {0}'}"
                               FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowDocumentReader, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Right Status Controls: Night Light (Yellowish Warmth + Controller) & PDF Zoom Slider -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nightlight Toggle + Yellow Level Controller -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ToggleButton IsChecked="{Binding IsNightLightEnabled, Mode=TwoWay}"
                                      Padding="9,4"
                                      Cursor="Hand"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      ToolTip="Toggle Warm Yellowish Night Light">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="NlBorder"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="BrightnessLow24" FontSize="14" Foreground="#FFFBBF24" Margin="0,0,5,0" />
                                                        <TextBlock Text="Night Light" FontSize="11.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="NlBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="NlBorder" Property="Background" Value="#33FBBF24" />
                                                        <Setter TargetName="NlBorder" Property="BorderBrush" Value="#FFFBBF24" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <Slider x:Name="NightLightSlider"
                                Minimum="0"
                                Maximum="100"
                                Width="105"
                                Margin="8,0,4,0"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                Value="{Binding NightLightLevel, Mode=TwoWay}"
                                ValueChanged="NightLightSlider_ValueChanged"
                                ToolTip="Adjust Night Light Warm Yellow Intensity (0–100%)" />

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   MinWidth="34"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding NightLightLevel, StringFormat='{}{0:0}%'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNightLightEnabled}" Value="False">
                                            <Setter Property="Text" Value="Off" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Quick Zoom Slider -->
                    <Border Visibility="{Binding ShowDocumentReader, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    DataContext="{Binding SelectedTab}">
                            <TextBlock Text="Zoom" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Minimum="25"
                                    Maximum="400"
                                    Width="130"
                                    VerticalAlignment="Center"
                                    Value="{Binding ZoomPercent, Mode=OneWay}"
                                    ValueChanged="ZoomSlider_ValueChanged" />
                            <TextBlock Text="{Binding ZoomPercent, StringFormat='{}{0:0}%'}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       MinWidth="44"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Full-Window Non-Blocking Night Light Warm Yellow Overlay -->
        <Rectangle x:Name="NightLightOverlay"
                   Grid.Row="0"
                   Grid.RowSpan="7"
                   Panel.ZIndex="1000"
                   IsHitTestVisible="False"
                   Fill="#FFFFA800"
                   Opacity="{Binding NightLightOverlayOpacity}" />
    </Grid>
</ui:FluentWindow>
